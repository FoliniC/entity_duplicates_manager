{
    "BASE_LOG_DIR": "/config/logs",
    "SUBSYSTEMS": {
        "fancoil": {
            "log_dir": "/config/logs/fancoil_events",
            "log_file": "fancoil_events.log",
            "archive": true,
            "rotation_type": "both",
            "max_bytes": 2097152,
            "when": "midnight",
            "interval": 1,
            "backup_count": 100,
            "state_persistence": true
        },
        "ev": {
            "log_dir": "/config/logs/EV",
            "log_file": "ev_events.log",
            "archive": true,
            "rotation_type": "both",
            "max_bytes": 2097152,
            "when": "midnight",
            "interval": 1,
            "backup_count": 100,
            "state_persistence": false
        },
        "scale": {
            "log_dir": "/config/logs/scale",
            "log_file": "scale_events.log",
            "archive": true,
            "rotation_type": "both",
            "max_bytes": 2097152,
            "when": "midnight",
            "interval": 1,
            "backup_count": 100,
            "state_persistence": false
        },
        "system": {
            "log_dir": "/config/logs/system",
            "log_file": "system.log",
            "archive": true,
            "rotation_type": "both",
            "max_bytes": 2097152,
            "when": "midnight",
            "interval": 1,
            "backup_count": 100,
            "state_persistence": false
        }
    }
}
