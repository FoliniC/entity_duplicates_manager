# ---------------------------------------------------------------------------
# Sensore: Umidità Assoluta (ω) %%friendly_name%%
# Calcola l'umidità specifica in g/kg da temperatura e umidità relativa pilota.
# Formula: omega = 0.622 * e / (1013.25 - e) * 1000
# dove e = 6.112 * exp(17.67 * T / (T + 243.5)) * RH / 100
# ---------------------------------------------------------------------------
- name: "Omega %%friendly_name%%"
  unique_id: omega_%%id%%
  unit_of_measurement: "g/kg"
  state_class: measurement
  device_class: humidity
  state: >-
    {% set temp = states('sensor.temperatura_%%id%%_pilota') | float(none) %}
    {% set rh = states('sensor.umidita_%%id%%_pilota') | float(none) %}
    {% if temp is not none and rh is not none and temp != 0 and rh != 0 %}
      {% set e_sat = 6.112 * exp(17.67 * temp / (temp + 243.5)) %}
      {% set e = e_sat * rh / 100 %}
      {% set omega = 0.622 * e / (1013.25 - e) * 1000 %}
      {{ omega | round(2) }}
    {% else %}
      unavailable
    {% endif %}
  availability: >-
    {{ states('sensor.temperatura_%%id%%_pilota') not in ['unavailable','unknown'] and
       states('sensor.umidita_%%id%%_pilota') not in ['unavailable','unknown'] }}
  attributes:
    temperatura_source: "sensor.temperatura_%%id%%_pilota"
    umidita_source: "sensor.umidita_%%id%%_pilota"
    formula: "omega = 0.622 * e / (1013.25 - e) * 1000, e = 6.112 * exp(17.67*T/(T+243.5)) * RH/100"