# Automazione: Memorizza ultima umidità %%friendly_name%% valida
# Aggiorna l'input_number helper solo quando il sensore pilota ha un valore valido (10-95%)
# Questo evita di "congelare" valori invalidi nella fotografia "prima" del sensore _con_validazione

- alias: "Memorizza ultima umidità %%friendly_name%% valida"
  id: memorizza_umidita_%%id%%_valida
  initial_state: true
  mode: single
  trigger:
    - platform: state
      entity_id: sensor.umidita_%%id%%_pilota
  condition:
    - condition: template
      value_template: >
        {{ trigger.to_state.state not in ['unknown', 'unavailable', '']
           and 10 <= (trigger.to_state.state | float(0)) <= 95 }}
  action:
    - service: input_number.set_value
      target:
        entity_id: input_number.umidita_%%id%%_ultima_valida
      data:
        value: "{{ trigger.to_state.state | float }}"