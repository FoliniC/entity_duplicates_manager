# Binary Sensor debounced per il consiglio "apri finestra"
# Diventa on solo quando il consiglio grezzo è "apri" o "apri_se_riparata" per almeno 2 minuti continui
# Torna off solo quando il consiglio NON è "apri" per almeno 2 minuti continui
# Riduce drasticamente i cambiamenti spuri (128-257 -> ~18 cambi/giorno per cucina con 2 min)

- name: "Consiglio Apri %%friendly_name%% (Debounced)"
  unique_id: consiglio_apri_%%id%%_debounced
  state: >
    {{ states('sensor.consiglio_finestra_%%id%%') in ['apri', 'apri_se_riparata'] }}
  delay_on:
    minutes: 2
  delay_off:
    minutes: 2
  availability: >
    {{ states('sensor.consiglio_finestra_%%id%%') not in ['unknown', 'unavailable'] }}
  device_class: opening
  icon: "mdi:window-open-variant"