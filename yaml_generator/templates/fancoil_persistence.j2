# Generated by: %%generator_name%%
# Template: %%template_name%%
# Generated at: %%generation_time%%

# Trigger-based sensors for better persistence across restarts
trigger:
    - platform: state
      entity_id: 
        - input_select.fancoil_%%id%%_temp_source
        - sensor.temperatura_%%id%%_reale_calcolata
        - input_select.fancoil_system_hvac_mode
        - input_boolean.fancoil_%%id%%_hvac_mode_follow_master
        - input_select.fancoil_%%id%%_hvac_mode_local
        - input_number.master_setpoint_heat
        - input_number.master_setpoint_cool
        - input_number.fancoil_%%id%%_sp_offset
        - input_boolean.fancoil_%%id%%_sp_follow_master
        - input_number.fancoil_%%id%%_setpoint
        - sensor.fancoil_%%id%%_humidity
    - platform: state
      entity_id:
        - input_text.fancoil_%%id%%_add_temp_entity
    - platform: state
      entity_id:
        - climate.controllo_temperatura_%%id%%
      attribute: temperature
    - platform: homeassistant
      event: start
    - platform: time_pattern
      minutes: "/15"
sensor:
    - name: "Fancoil %%friendly_name%% Saved Temp Source"
      unique_id: fancoil_%%id%%_saved_temp_source
      state: >-
        {% if trigger.entity_id is defined and trigger.entity_id == 'input_select.fancoil_%%id%%_temp_source' %}
          {{ states('input_select.fancoil_%%id%%_temp_source') }}
        {% elif trigger.entity_id is defined and trigger.entity_id == 'input_text.fancoil_%%id%%_add_temp_entity' and states('input_text.fancoil_%%id%%_add_temp_entity') != "" %}
          {{ states('input_text.fancoil_%%id%%_add_temp_entity') }}
        {% else %}
          {{ this.state | default('sensor.fancoil_%%id%%_temperature') }}
        {% endif %}

    - name: "Fancoil %%friendly_name%% Temp Sources History"
      unique_id: fancoil_%%id%%_temp_sources_history
      state: >-
        {% set defaults = ['sensor.fancoil_%%id%%_temperature'] %}
        {% if "%%ref_sensor%%" != "%%" ~ "ref_sensor" ~ "%%" and "%%ref_sensor%%" != "" %}
          {% set defaults = defaults + ["%%ref_sensor%%"] %}
        {% endif %}
        {% if "%%knx_temp_sensor%%" != "%%" ~ "knx_temp_sensor" ~ "%%" and "%%knx_temp_sensor%%" != "" %}
          {% set defaults = defaults + ["%%knx_temp_sensor%%"] %}
        {% endif %}
        
        {% set current_list = (this.state | default(defaults | join(','))).split(',') %}
        {% set new_entity = states('input_text.fancoil_%%id%%_add_temp_entity') %}
        {% if trigger.entity_id is defined and trigger.entity_id == 'input_text.fancoil_%%id%%_add_temp_entity' and new_entity != "" and new_entity not in current_list %}
          {{ (current_list + [new_entity]) | join(',') }}
        {% else %}
          {{ current_list | join(',') }}
        {% endif %}

    - name: "Fancoil %%friendly_name%% HVAC Temp Mode"
      unique_id: fancoil_%%id%%_hvac_temp_mode
      state: >-
        {% set follow_master = is_state('input_boolean.fancoil_%%id%%_hvac_mode_follow_master','on') %}
        {% set master_hvac_mode = states('input_select.fancoil_system_hvac_mode') %}
        {% set local_mode = states('input_select.fancoil_%%id%%_hvac_mode_local') %}
        
        {% if follow_master and master_hvac_mode not in ['unavailable', 'unknown', None] %}
            {{ master_hvac_mode }}
        {% elif not follow_master and local_mode not in ['unavailable', 'unknown', None] %}
            {{ local_mode }}
        {% else %}
            {{ this.state | default('off') }}
        {% endif %}

    - name: "Fancoil %%friendly_name%% Temperature Difference"
      unique_id: fancoil_%%id%%_temperature_difference
      unit_of_measurement: "°C"
      state: >-
        {% set hvac_mode = states('sensor.fancoil_%%id%%_hvac_temp_mode') %}
        {% if hvac_mode == 'off' %}
          0
        {% else %}
          {# Usiamo i valori del CLIMATE per coerenza con la UI #}
          {% set t_curr = state_attr('climate.controllo_temperatura_%%id%%', 'current_temperature') %}
          {% set target_sp = state_attr('climate.controllo_temperatura_%%id%%', 'temperature') %}

          {% if t_curr is not none and target_sp is not none %}
            {% if hvac_mode == 'heat' %}
              {{ (target_sp - t_curr) | round(1) }}
            {% elif hvac_mode == 'cool' %}
              {{ (t_curr - target_sp) | round(1) }}
            {% else %}
              0
            {% endif %}
          {% else %}
            {# Fallback ai calcoli manuali se climate non disponibile #}
            {% set t_curr_fallback = states('sensor.temperatura_%%id%%_reale_calcolata') | float(21.0) %}
            
            {# Calcoliamo il setpoint teorico #}
            {% set master_hvac = states('input_select.fancoil_system_hvac_mode') %}
            {% set sp_heat = states('input_number.master_setpoint_heat') | float(20) %}
            {% set sp_cool = states('input_number.master_setpoint_cool') | float(26) %}
            {% set offset = states('input_number.fancoil_%%id%%_sp_offset') | float(0) | round(1) %}
            {% set follow = is_state('input_boolean.fancoil_%%id%%_sp_follow_master', 'on') %}
            {% set local_sp = states('input_number.fancoil_%%id%%_setpoint') | float(21) %}
            
            {% set target_sp_fallback = local_sp %}
            {% if follow and master_hvac not in ['unknown', 'unavailable', None] %}
               {% if master_hvac == 'heat' %}
                 {% set target_sp_fallback = sp_heat + offset %}
               {% elif master_hvac == 'cool' %}
                 {% set target_sp_fallback = sp_cool + offset %}
               {% endif %}
            {% endif %}
            
            {% if hvac_mode == 'heat' %}
              {{ (target_sp_fallback - t_curr_fallback) | round(1) }}
            {% elif hvac_mode == 'cool' %}
              {{ (t_curr_fallback - target_sp_fallback) | round(1) }}
            {% else %}
               0
            {% endif %}
          {% endif %}
        {% endif %}

    - name: "Fancoil %%friendly_name%% Saved Offset"
      unique_id: fancoil_%%id%%_saved_offset
      unit_of_measurement: "°C"
      state: >-
        {% set current_offset = states('input_number.fancoil_%%id%%_sp_offset') %}
        {% if trigger.entity_id is defined and trigger.entity_id == 'input_number.fancoil_%%id%%_sp_offset' %}
          {% if current_offset not in ['unavailable', 'unknown', None, ''] %}
            {{ current_offset | float }}
          {% else %}
            {{ this.state | float(0) }}
          {% endif %}
        {% else %}
          {{ this.state | float(0) }}
        {% endif %}

    - name: "Fancoil %%friendly_name%% Last Temperature"
      unique_id: fancoil_%%id%%_last_temperature
      unit_of_measurement: "°C"
      attributes:
        persistence: trigger_based
        managed_by: yaml_generator
      state: >-
        {% set current = states('sensor.temperatura_%%id%%_reale_calcolata') %}
        {% if current not in ['unavailable', 'unknown', None, ''] %}
          {{ current | float }}
        {% else %}
          {{ this.state | float(21.0) }}
        {% endif %}

    - name: "Fancoil %%friendly_name%% Last Humidity"
      unique_id: fancoil_%%id%%_last_humidity
      unit_of_measurement: "%"
      attributes:
        persistence: trigger_based
        managed_by: yaml_generator
      state: >-
        {% set current = states('sensor.fancoil_%%id%%_humidity') %}
        {% if current not in ['unavailable', 'unknown', None, ''] %}
          {{ current | float }}
        {% else %}
          {{ this.state | float(50.0) }}
        {% endif %}
