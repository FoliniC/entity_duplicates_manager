# Generated by: %%generator_name%%
# Template: %%template_name%%
# Generated at: %%generation_time%%

- title: Climatizzazione - Modalità Verifica (Fase 13)
  type: vertical-stack
  cards:
    - type: markdown
      content: >-
        ## 🎛️ Modalità Verifica Interattiva (Fase 13)
        
        **Panoramica:**
        - **Verifica Mode**: attiva la modalità di verifica interattiva per sostituire i consigli automatici
        - **Controlli Manuali**: ogni stanza mostra pulsanti per azionare aperte/chiuse/pausa/reset
        - **Monitoraggio**: tutte le azioni vengono registrate per tuning algorithmico
        
        **Istruzioni:**
        1. Accendere **Verifica Mode** per iniziare il test
        2. Usare pulsanti manuali per verificare comportamento del sistema
        3. Osservare le modifiche nei consigli sistema e nello stato finestra
        4. Disattivare quando test completato
        
        **Metriche:** Ogni stanza mostra override rate, consigli corretti, trend umidità
        e stato finestra corrente.
    
    - type: custom:mod-card
      card_mod:
        style: |
          ha-card {
            border: 3px solid #2196F3 !important;
            border-radius: 12px !important;
            padding: 12px !important;
            background: linear-gradient(135deg, #e3f2fd 0%, #fff3e0 100%) !important;
          }
      card:
        type: grid
        columns: 2
        square: false
        cards:
          # Primary Controls
          - type: custom:mushroom-template-card
            primary: "🔘 Verifica Mode"
            secondary: "Disattivato"
            entity: input_boolean.verifica_mode
            icon: mdi:shield-check
            icon_color: red
            tap_action:
              action: toggle
              target:
                entity_id: input_boolean.verifica_mode
          
          - type: custom:mushroom-template-card
            primary: "📊 Override Rate"
            secondary: "Caricamento..."
            entity: sensor.analytics_tuning_%%id%%
            icon: mdi:percent
            icon_color: orange
            tap_action:
              action: more-info
          
          # Window State (from Phase 3)
          - type: entities
            show_header_toggle: false
            state_color: true
            entities:
              - entity: input_boolean.finestra_%%id%%_aperta
                name: Finestra
                icon: mdi:window-open
          
          # Current Recommendation
          - type: custom:mushroom-template-card
            primary: "💡 Consiglia"
            secondary: "Caricamento..."
            entity: sensor.consiglio_finestra_%%id%%
            icon: mdi:lightbulb
            icon_color: yellow
            tap_action:
              action: more-info
          
          # Trend
          - type: custom:mushroom-template-card
            primary: "📈 Trend"
            secondary: "Caricamento..."
            entity: sensor.trend_umidita_%%id%%
            icon: mdi:trending-up
            icon_color: teal
            tap_action:
              action: more-info
          
          # Manual Action Button
          - type: vertical-stack
            cards:
              - type: button
                name: "🟢 OPEN 15m"
                icon: mdi:window-open-variant
                tap_action:
                  action: call-service
                  service: input_boolean.turn_on
                  target:
                    entity_id: input_boolean.finestra_%%id%%_aperta
                  data:
                    duration: 900
              - type: button
                name: "🔴 CLOSE 5m"
                icon: mdi:window-closed-variant
                tap_action:
                  action: call-service
                  service: input_boolean.turn_off
                  target:
                    entity_id: input_boolean.finestra_%%id%%_aperta
                  data:
                    duration: 300
              - type: button
                name: "⏸️ PAUSE"
                icon: mdi:pause
                tap_action:
                  action: call-service
                  service: input_boolean.turn_on
                  target:
                    entity_id: input_boolean.verifica_mode
                  data:
                    verifica_pause: true
              - type: button
                name: "🔄 RESET"
                icon: mdi:refresh
                tap_action:
                  action: call-service
                  service: input_boolean.turn_off
                  target:
                    entity_id: input_boolean.verifica_mode
                  data:
                    reset_mode: true
          
          # Manual Log Access
          - type: custom:mushroom-template-card
            primary: "📝 Log Manuali"
            secondary: "Visualizza azioni registrate"
            entity: sensor.log_attivita_manuali_%%id%%
            icon: mdi:clipboard-text
            icon_color: purple
            tap_action:
              action: more-info