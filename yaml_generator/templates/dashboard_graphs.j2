# Generated by: %%generator_name%%
# Template: %%template_name%%
# Generated at: %%generation_time%%

  - title: "Grafici {{ friendly_name }}"
    path: "fancoil-grafici-{{ id }}"
    subview: true
    cards:
      - type: vertical-stack
        cards:
          # === TEMPERATURA ===
          - type: markdown
            content: "## 🌡️ Temperature"
          - type: history-graph
            hours_to_show: 24
            title: "Temperatura - 24h"
            entities:
              - entity: sensor.fancoil_{{ id }}_temperature
                name: "Fancoil"
              {% if ref_sensor and "sensor.th" in ref_sensor %}
              - entity: {{ ref_sensor }}
                name: "Tuya TH"
              {% endif %}
              {% if knx_temp_sensor %}
              - entity: {{ knx_temp_sensor }}
                name: "KNX"
              {% endif %}
          - type: history-graph
            hours_to_show: 168
            title: "Temperatura - 7 giorni"
            entities:
              - entity: sensor.fancoil_{{ id }}_temperature
                name: "Fancoil"
              {% if ref_sensor and "sensor.th" in ref_sensor %}
              - entity: {{ ref_sensor }}
                name: "Tuya TH"
              {% endif %}
              {% if knx_temp_sensor %}
              - entity: {{ knx_temp_sensor }}
                name: "KNX"
              {% endif %}

          # === UMIDITÀ ===
          - type: markdown
            content: "## 💧 Umidità"
          - type: history-graph
            hours_to_show: 24
            title: "Umidità - 24h"
            entities:
              - entity: sensor.fancoil_{{ id }}_humidity
                name: "Fancoil"
              {% if humidity_sensor and "sensor.th" in humidity_sensor %}
              - entity: {{ humidity_sensor }}
                name: "Tuya TH"
              {% endif %}
          - type: history-graph
            hours_to_show: 168
            title: "Umidità - 7 giorni"
            entities:
              - entity: sensor.fancoil_{{ id }}_humidity
                name: "Fancoil"
              {% if humidity_sensor and "sensor.th" in humidity_sensor %}
              - entity: {{ humidity_sensor }}
                name: "Tuya TH"
              {% endif %}

          # === UMIDITÀ SPECIFICA E PUNTO DI RUGIADA ===
          - type: markdown
            content: "## 📊 Umidità Specifica (ω) e Punto di Rugiada"
          - type: history-graph
            hours_to_show: 24
            title: "Umidità Specifica (ω) - 24h"
            entities:
              - entity: sensor.omega_{{ id }}
                name: "ω Interna"
              - entity: sensor.omega_esterno
                name: "ω Esterna"
          - type: history-graph
            hours_to_show: 168
            title: "Umidità Specifica (ω) - 7 giorni"
            entities:
              - entity: sensor.omega_{{ id }}
                name: "ω Interna"
              - entity: sensor.omega_esterno
                name: "ω Esterna"
          - type: history-graph
            hours_to_show: 24
            title: "Punto di Rugiada - 24h"
            entities:
              - entity: sensor.punto_di_rugiada_{{ id }}
                name: "Rugiada Interna"
              - entity: sensor.punto_di_rugiada_esterno
                name: "Rugiada Esterna"
          - type: history-graph
            hours_to_show: 168
            title: "Punto di Rugiada - 7 giorni"
            entities:
              - entity: sensor.punto_di_rugiada_{{ id }}
                name: "Rugiada Interna"
              - entity: sensor.punto_di_rugiada_esterno
                name: "Rugiada Esterna"

          # === DELTA TEMPERATURA (se disponibile) ===
          {% if th_id %}
          - type: markdown
            content: "## 📈 Delta Temperatura (Tuya vs Fancoil)"
          - type: history-graph
            hours_to_show: 24
            title: "Delta Temp - 24h"
            entities:
              - entity: sensor.fancoil_{{ id }}_temp_delta_th_vs_internal
                name: "Delta TH vs Fancoil"
          - type: history-graph
            hours_to_show: 168
            title: "Delta Temp - 7 giorni"
            entities:
              - entity: sensor.fancoil_{{ id }}_temp_delta_th_vs_internal
                name: "Delta TH vs Fancoil"
          {% endif %}
          {% if knx_temp_sensor %}
          - type: markdown
            content: "## 📈 Delta Temperatura (KNX vs Rif)"
          - type: history-graph
            hours_to_show: 24
            title: "Delta Temp KNX - 24h"
            entities:
              - entity: sensor.fancoil_{{ id }}_temp_delta_knx_vs_ref
                name: "Delta KNX vs Rif"
          - type: history-graph
            hours_to_show: 168
            title: "Delta Temp KNX - 7 giorni"
            entities:
              - entity: sensor.fancoil_{{ id }}_temp_delta_knx_vs_ref
                name: "Delta KNX vs Rif"
          {% endif %}

          # === DELTA UMIDITÀ (se disponibile) ===
          {% if th_id %}
          - type: markdown
            content: "## 📈 Delta Umidità (Tuya vs Fancoil)"
          - type: history-graph
            hours_to_show: 24
            title: "Delta Hum - 24h"
            entities:
              - entity: sensor.fancoil_{{ id }}_hum_delta_th_vs_internal
                name: "Delta TH vs Fancoil"
          - type: history-graph
            hours_to_show: 168
            title: "Delta Hum - 7 giorni"
            entities:
              - entity: sensor.fancoil_{{ id }}_hum_delta_th_vs_internal
                name: "Delta TH vs Fancoil"
          {% endif %}

          # === TREND UMIDITÀ ===
          - type: markdown
            content: "## 📈 Trend Umidità"
          - type: history-graph
            hours_to_show: 24
            title: "Trend Umidità - 24h"
            entities:
              - entity: sensor.trend_umidita_{{ id }}
                name: "Trend"
          - type: history-graph
            hours_to_show: 168
            title: "Trend Umidità - 7 giorni"
            entities:
              - entity: sensor.trend_umidita_{{ id }}
                name: "Trend"

          # === CONFORT E CONSIGLI ===
          - type: markdown
            content: "## ⚖️ Comfort e Consigli"
          - type: history-graph
            hours_to_show: 24
            title: "Stato Comfort - 24h"
            entities:
              - entity: sensor.comfort_evaluation_{{ id }}
                name: "Stato Comfort"
              - entity: sensor.climate_advice_{{ id }}
                name: "Consiglio Climatico"
          - type: history-graph
            hours_to_show: 168
            title: "Stato Comfort - 7 giorni"
            entities:
              - entity: sensor.comfort_evaluation_{{ id }}
                name: "Stato Comfort"
              - entity: sensor.climate_advice_{{ id }}
                name: "Consiglio Climatico"

          # === TORNA INDIETRO ===
          - type: button
            name: Torna Indietro
            icon: mdi:arrow-left
            tap_action:
              action: navigate
              navigation_path: /riscaldamento-1/climatizzazione