    {% set circuit_threshold_cool = states('input_number.circuit_temp_threshold_cool') | float(20) %}
    {% set window_open = states('%%WINDOW_CONTACT_SENSOR%%') == 'on' %}

    {% set stop_by_diff = (hvac_temp_mode != 'off' and diff <= soglia_stop) %}
    {% set stop_by_circuit_temp = false %}

    {% if hvac_temp_mode == 'heat' and circuit_temp < circuit_threshold_heat %}
      {% set stop_by_circuit_temp = true %}
    {% elif hvac_temp_mode == 'cool' and circuit_temp > circuit_threshold_cool %}
      {% set stop_by_circuit_temp = true %}
    {% endif %}

    {{ stop_by_diff or stop_by_circuit_temp or window_open }}