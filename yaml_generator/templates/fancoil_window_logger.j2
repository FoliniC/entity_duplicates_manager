# Generated by: %%generator_name%%
# Template: %%template_name%%
# Generated at: %%generation_time%%

# FASE 8 - Window State & Advice Logger
# Logga i cambiamenti di stato finestra e consiglio finestra nel log fancoil_events
trigger:
  - platform: state
    entity_id:
      - input_boolean.finestra_%%id%%_aperta
      - sensor.consiglio_finestra_%%id%%
sensor:
  - name: "Finestra %%friendly_name%% Logger"
    unique_id: finestra_%%id%%_logger
    state: >
      {% set finestra = is_state('input_boolean.finestra_%%id%%_aperta', 'on') %}
      {% set consiglio = states('sensor.consiglio_finestra_%%id%%') %}
      {% set rh = states('sensor.umidita_%%id%%_pilota') | float(0) %}
      {% set omega_int = states('sensor.omega_%%id%%') | float(0) %}
      {% set omega_ext = states('sensor.omega_esterno') | float(0) %}
      {% set delta_omega = (omega_int - omega_ext) | round(2) %}
      {% set trend = states('sensor.trend_umidita_%%id%%') %}
      {{ 'aperta' if finestra else 'chiusa' }} | {{ consiglio }} | RH={{ rh }}% | Δω={{ delta_omega }} | trend={{ trend }}
    attributes:
      finestra_aperta: "{{ is_state('input_boolean.finestra_%%id%%_aperta', 'on') }}"
      consiglio_finestra: "{{ states('sensor.consiglio_finestra_%%id%%') }}"
      rh_int: "{{ states('sensor.umidita_%%id%%_pilota') | float(0) }}"
      omega_int: "{{ states('sensor.omega_%%id%%') | float(0) }}"
      omega_ext: "{{ states('sensor.omega_esterno') | float(0) }}"
      delta_omega: "{{ (states('sensor.omega_%%id%%') | float(0) - states('sensor.omega_esterno') | float(0)) | round(2) }}"
      trend_umidita: "{{ states('sensor.trend_umidita_%%id%%') }}"
      temp_int: "{{ states('sensor.temperatura_%%id%%_reale_calcolata') | float(0) }}"
      fancoil_attivo: "{{ is_state('switch.fancoil_%%id%%_switch_1', 'on') or is_state('switch.fancoil_%%id%%_switch_2', 'on') or is_state('switch.fancoil_%%id%%_switch_3', 'on') or is_state('switch.fancoil_%%id%%_switch_4', 'on') }}"
    availability: >
      {{ has_value('input_boolean.finestra_%%id%%_aperta') and has_value('sensor.consiglio_finestra_%%id%%') }}
  - action: call_service
    service: logbook.log
    data:
      name: "Finestra %%friendly_name%%"
      message: >
        {% set finestra = is_state('input_boolean.finestra_%%id%%_aperta', 'on') %}
        {% set consiglio = states('sensor.consiglio_finestra_%%id%%') %}
        {% set rh = states('sensor.umidita_%%id%%_pilota') | float(0) %}
        {% set delta_omega = (states('sensor.omega_%%id%%') | float(0) - states('sensor.omega_esterno') | float(0)) | round(2) %}
        {% set trend = states('sensor.trend_umidita_%%id%%') %}
        Finestra {{ 'APERTA' if finestra else 'CHIUSA' }} | Consiglio: {{ consiglio }} | RH={{ rh }}% | Δω={{ delta_omega }} | Trend={{ trend }}
    target: {}
  - action: fancoil_log_event
    data:
      level: info
      message: >
        {% set finestra = is_state('input_boolean.finestra_%%id%%_aperta', 'on') %}
        {% set consiglio = states('sensor.consiglio_finestra_%%id%%') %}
        {% set rh = states('sensor.umidita_%%id%%_pilota') | float(0) %}
        {% set delta_omega = (states('sensor.omega_%%id%%') | float(0) - states('sensor.omega_esterno') | float(0)) | round(2) %}
        {% set trend = states('sensor.trend_umidita_%%id%%') %}
        [%%friendly_name%%] WINDOW: Finestra {{ 'APERTA' if finestra else 'CHIUSA' }} | Consiglio: {{ consiglio }} | RH={{ rh }}% | Δω={{ delta_omega }} | Trend={{ trend }}
    target: {}