# Generated by: %%generator_name%%
# Template: %%template_name%%
# Generated at: %%generation_time%%

# FASE 9 - Sistema di Valutazione con Controllo Qualità Dati Avanzato
# Trigger-based template sensor con validazione dati completa e fallback logic.
# Risolve problemi di dati non validi che causavano valutazioni errate (es. umidità impossibile).

trigger:
%%TRIGGERS_YAML%%

sensor:
# ---------------------------------------------------------------------------
# LAYER 1: VALIDAZIONE DATI PRIMARIA
# Controlla se i dati sono validi prima di qualsiasi valutazione
# ---------------------------------------------------------------------------
- name: "Esito Ultimo Consiglio Finestra %%friendly_name%% Validated"
  unique_id: esito_ultimo_consiglio_finestra_%%id%%_validated
  variables:
    window_contact_sensor: %%WINDOW_CONTACT_SENSOR%%
    umidita_helper: "input_number.umidita_%%id%%_ultima_valida"
    th_humidity_sensor: "%%TH_HUMIDITY_SENSOR%%"
    external_humidity_sensor: "%%EXTERNAL_HUMIDITY_SENSOR%%"
  state: >-
    {% set consiglio = states('sensor.consiglio_finestra_%%id%%') %}
    {% set finestra = states(window_contact_sensor) if window_contact_sensor else states('input_boolean.finestra_%%id%%_aperta') %}
    {% set rh = states('sensor.umidita_%%id%%_pilota') | float(none) %}
    {% set rh_th = states(th_humidity_sensor) | float(none) if th_humidity_sensor else none %}  {# KNX TH come fallback #}
    {% set rh_external = states(external_humidity_sensor) | float(none) %}  {# Meteo esterno come fallback #}
    {% set u_prima_helper = states('input_number.umidita_%%id%%_ultima_valida') | float(none) %}
    {# Fallback: se helper non valido (es. al primo avvio prima restore), usa lettura corrente #}
    {% set u_prima = u_prima_helper if (u_prima_helper is not none and 10 <= u_prima_helper <= 95) else rh %}
    {% set u_prima_valida = u_prima is not none and 10 <= u_prima <= 95 %}
    {% set prev_state = this.state | default('in_attesa') %}
    {% set prev_attrs = this.attributes | default({}) %}

    {# ---------------------------------------------------------------------------
       CHECK DATI QUALITÀ #1: Validità sensore primario
       --------------------------------------------------------------------------- #}
    {% set primary_data_valid = rh is not none and rh >= 0 and rh <= 100 %}
    {% set th_data_valid = rh_th is not none and rh_th >= 0 and rh_th <= 100 %}
    {% set external_data_valid = rh_external is not none and rh_external >= 0 and rh_external <= 100 %}
    {% set any_data_valid = primary_data_valid or th_data_valid or external_data_valid %}

    {# ---------------------------------------------------------------------------
       CHECK DATI QUALITÀ #2: Transition Rate Validation
       --------------------------------------------------------------------------- #}
    {% set max_rate_15min_opening = 30.0 %}
    {% set max_rate_15min_closing = 20.0 %}
    {% set max_rate_30min_opening = 50.0 %}
    {% set max_rate_30min_closing = 35.0 %}
    {% set max_rate_60min_opening = 80.0 %}
    {% set max_rate_60min_closing = 50.0 %}

    {# ---------------------------------------------------------------------------
       CHECK DATI QUALITÀ #3: Coherence Check (Pilota vs TH vs External)
       --------------------------------------------------------------------------- #}
    {% set coherence_check_passed = false %}
    {% if primary_data_valid and th_data_valid %}
      {% set th_to_pilot_ratio = (rh - rh_th) | abs %}
      {% if th_to_pilot_ratio <= 15.0 %}
        {% set coherence_check_passed = true %}
      {% endif %}
    {% endif %}
    {% if coherence_check_passed == false and primary_data_valid and external_data_valid %}
      {% set external_to_pilot_ratio = (rh - rh_external) | abs %}
      {% if external_to_pilot_ratio <= 20.0 %}
        {% set coherence_check_passed = true %}
      {% endif %}
    {% endif %}
    {% if coherence_check_passed == false %}
      {% set coherence_check_passed = true %}  {# Allow if only one valid sensor #}
    {% endif %}

    {# ---------------------------------------------------------------------------
       CHECK DATI QUALITÀ #4: Stability Check (Recent trend validation)
       --------------------------------------------------------------------------- #}
    {% set trend = states('sensor.trend_umidita_%%id%%') %}
    {% set trend_unstable = trend in ['incerto', 'unknown'] %}
    {% set current_time = now() | as_timestamp %}
    {% set last_update = state_attr('sensor.umidita_%%id%%_pilota', 'last_updated') %}
    {% if last_update %}
      {% set last_update_time = as_timestamp(last_update) %}
      {% set data_age_minutes = (current_time - last_update_time) / 60 %}
      {% set data_too_old = data_age_minutes > 60 %}
    {% else %}
      {% set data_age_minutes = 999 %}
      {% set data_too_old = true %}
    {% endif %}
    {% set trend_valid = trend not in ['incerto', 'unknown'] %}

    {# ---------------------------------------------------------------------------
       MAIN LOGIC: Evaluation Flow + Session Attribute Computation
       --------------------------------------------------------------------------- #}
    {# Default session attribute values (persist from prev_attrs) #}
    {% set ora_inizio_valutazione = prev_attrs.get('ora_inizio_valutazione', 'N/A') %}
    {% set tipo_azione = prev_attrs.get('tipo_azione', 'N/A') %}
    {% set consiglio_valutato = prev_attrs.get('consiglio_valutato', 'N/A') %}
    {% set umidita_inizio = prev_attrs.get('umidita_inizio', 'N/A') %}
    {% set esito_15m = prev_attrs.get('esito_15m', 'N/A') %}
    {% set esito_30m = prev_attrs.get('esito_30m', 'N/A') %}
    {% set esito_60m = prev_attrs.get('esito_60m', 'N/A') %}

    {# Determine new state and update session attributes #}
    {% set new_state = prev_state %}

    {% if trigger.id == 'advice_changed' %}
      {% if trigger.to_state.state in ['apri', 'apri_se_riparata', 'chiudi'] %}
        {% if not u_prima_valida and primary_data_valid %}
          {# Startup fallback: helper not ready but current sensor reading valid -> use it #}
          {% set new_state = 'in_attesa' %}
        {% elif not u_prima_valida %}
          {# No helper and no current reading yet -> stay in_attesa (waiting for first valid data) #}
          {% set new_state = prev_state %}
        {% elif not any_data_valid %}
          {% set new_state = 'non_valutabile' %}  {# No valid data available #}
        {% else %}
          {% set new_state = 'in_attesa' %}
          {# Initialize session attributes for new evaluation #}
          {% set ora_inizio_valutazione = (now() | as_timestamp) | string %}
          {% set consiglio_valutato = trigger.to_state.state %}
          {% set umidita_inizio = u_prima %}
          {% if trigger.to_state.state in ['apri', 'apri_se_riparata'] %}
            {% set tipo_azione = 'apertura' %}
          {% else %}
            {% set tipo_azione = 'chiusura' %}
          {% endif %}
          {# Reset milestone results #}
          {% set esito_15m = 'N/A' %}
          {% set esito_30m = 'N/A' %}
          {% set esito_60m = 'N/A' %}
        {% endif %}
      {% elif trigger.to_state.state in ['nessuna_azione', 'incerto', 'mantieni_aperta', 'mantieni_chiusa'] %}
        {% if prev_state == 'in_corso' %}
          {% set new_state = 'in_corso' %}
        {% else %}
          {% set new_state = 'non_valutabile' %}  {# Cannot evaluate without previous data #}
        {% endif %}
      {% else %}
        {% set new_state = prev_state %}
      {% endif %}

    {% elif trigger.id == 'window_changed' %}
      {% if prev_state == 'in_attesa' %}
        {% set cons_val = prev_attrs.get('consiglio_valutato', '') %}
        {% if trigger.to_state.state == 'on' and cons_val in ['apri', 'apri_se_riparata'] %}
          {% if not u_prima_valida and primary_data_valid %}
            {% set new_state = 'in_corso' %}
          {% elif not u_prima_valida %}
            {% set new_state = 'non_valutabile' %}
          {% elif not any_data_valid %}
            {% set new_state = 'non_valutabile' %}
          {% else %}
            {% set new_state = 'in_corso' %}
            {# Initialize session if not already set #}
            {% if ora_inizio_valutazione == 'N/A' %}
              {% set ora_inizio_valutazione = (now() | as_timestamp) | string %}
              {% set umidita_inizio = u_prima %}
              {% set tipo_azione = 'apertura' %}
            {% endif %}
          {% endif %}
        {% elif trigger.to_state.state == 'off' and cons_val == 'chiudi' %}
          {% if not u_prima_valida and primary_data_valid %}
            {% set new_state = 'in_corso' %}
          {% elif not u_prima_valida %}
            {% set new_state = 'non_valutabile' %}
          {% elif not any_data_valid %}
            {% set new_state = 'non_valutabile' %}
          {% else %}
            {% set new_state = 'in_corso' %}
            {% if ora_inizio_valutazione == 'N/A' %}
              {% set ora_inizio_valutazione = (now() | as_timestamp) | string %}
              {% set umidita_inizio = u_prima %}
              {% set tipo_azione = 'chiusura' %}
            {% endif %}
          {% endif %}
        {% else %}
          {% set new_state = prev_state %}
        {% endif %}
      {% elif prev_state == 'in_corso' %}
        {% if data_too_old %}
          {% set new_state = 'non_valutabile' %}  {# Data too old to trust #}
        {% elif not coherence_check_passed %}
          {% set new_state = 'non_valutabile' %}  {# Sensors don't agree #}
        {% else %}
          {# Continue evaluation with available data #}
          {% set t_inizio = ora_inizio_valutazione %}
          {% if t_inizio != 'N/A' %}
            {% set elapsed = current_time - as_timestamp(t_inizio) %}
            {% if elapsed < 900 %}
              {% set new_state = 'non_valutabile' %}  {# Too soon for evaluation #}
            {% elif elapsed < 1800 %}
              {% set new_state = esito_15m %}
            {% elif elapsed < 3600 %}
              {% set new_state = esito_30m %}
            {% else %}
              {% set new_state = esito_60m %}
            {% endif %}
          {% else %}
            {% set new_state = 'non_valutabile' %}
          {% endif %}
        {% endif %}
      {% else %}
        {% set new_state = prev_state %}
      {% endif %}

    {% elif trigger.id == 'time_tick' %}
      {% if prev_state == 'in_corso' %}
        {% set t_inizio = ora_inizio_valutazione %}
        {% if t_inizio != 'N/A' %}
          {% set elapsed = current_time - as_timestamp(t_inizio) %}
          {% if elapsed >= 3600 %}
            {# 60 minuti decorsi, finalizziamo con logica di validazione completa #}
            {% set val_60 = esito_60m %}
            {% if val_60 in [none, '', 'in_attesa', 'unknown', 'N/A'] %}
              {% set rh_ini = umidita_inizio | float(none) %}
              {% set tipo = tipo_azione %}
              {% set rh_ini_debug = rh_ini | round(2) %}
              {% set rh_debug = rh | round(2) %}

              {% if not any_data_valid %}
                {% set new_state = 'non_valutabile' %}  {# No valid data available at all #}
                {% set esito_60m = 'non_valutabile' %}
              {% else %}
                {% set delta_h = rh - rh_ini %}
                {% set delta_h_debug = delta_h | round(2) %}
                {% set trend = states('sensor.trend_umidita_%%id%%') %}
                {% set trend_valid = trend not in ['incerto', 'unknown'] %}

                {# APPLY VALIDATION LAYER #}
                {% if tipo == 'apertura' %}
                  {% if delta_h_debug < -30.0 or delta_h_debug > 30.0 %}
                    {% set new_state = 'inefficace' %}  {# Reject impossible data #}
                    {% set esito_60m = 'inefficace' %}
                  {% else %}
                    {% if delta_h <= -2.0 or (trend == 'in_calata' and delta_h < 0 and trend_valid) %}
                      {% set new_state = 'efficace' %}
                      {% set esito_60m = 'efficace' %}
                    {% else %}
                      {% set new_state = 'inefficace' %}
                      {% set esito_60m = 'inefficace' %}
                    {% endif %}
                  {% endif %}
                {% elif tipo == 'chiusura' %}
                  {% if delta_h_debug < -20.0 or delta_h_debug > 20.0 %}
                    {% set new_state = 'inefficace' %}  {# Reject impossible data #}
                    {% set esito_60m = 'inefficace' %}
                  {% else %}
                    {% set trend = states('sensor.trend_umidita_%%id%%') %}
                    {% if delta_h <= 0.4 or trend in ['stabile', 'in_calata'] %}
                      {% set new_state = 'efficace' %}
                      {% set esito_60m = 'efficace' %}
                    {% else %}
                      {% set new_state = 'inefficace' %}
                      {% set esito_60m = 'inefficace' %}
                    {% endif %}
                  {% endif %}
                {% else %}
                  {% set new_state = 'non_valutabile' %}
                  {% set esito_60m = 'non_valutabile' %}
                {% endif %}
              {% endif %}
            {% else %}
              {% set new_state = val_60 %}
            {% endif %}
          {% elif elapsed >= 1800 %}
            {# 30 min milestone #}
            {% set val_30 = esito_30m %}
            {% if val_30 in [none, '', 'in_attesa', 'unknown', 'N/A'] %}
              {% set rh_ini = umidita_inizio | float(none) %}
              {% set tipo = tipo_azione %}
              {% if rh_ini is not none and any_data_valid %}
                {% set delta_h = rh - rh_ini %}
                {% set trend = states('sensor.trend_umidita_%%id%%') %}
                {% set trend_valid = trend not in ['incerto', 'unknown'] %}
                {% if tipo == 'apertura' %}
                  {% if delta_h <= -2.0 or (trend == 'in_calata' and delta_h < 0 and trend_valid) %}
                    {% set esito_30m = 'efficace' %}
                  {% else %}
                    {% set esito_30m = 'inefficace' %}
                  {% endif %}
                {% elif tipo == 'chiusura' %}
                  {% if delta_h <= 0.4 or trend in ['stabile', 'in_calata'] %}
                    {% set esito_30m = 'efficace' %}
                  {% else %}
                    {% set esito_30m = 'inefficace' %}
                  {% endif %}
                {% else %}
                  {% set esito_30m = 'non_valutabile' %}
                {% endif %}
              {% else %}
                {% set esito_30m = 'non_valutabile' %}
              {% endif %}
            {% endif %}
            {% set new_state = esito_30m %}
          {% elif elapsed >= 900 %}
            {# 15 min milestone #}
            {% set val_15 = esito_15m %}
            {% if val_15 in [none, '', 'in_attesa', 'unknown', 'N/A'] %}
              {% set rh_ini = umidita_inizio | float(none) %}
              {% set tipo = tipo_azione %}
              {% if rh_ini is not none and any_data_valid %}
                {% set delta_h = rh - rh_ini %}
                {% set trend = states('sensor.trend_umidita_%%id%%') %}
                {% set trend_valid = trend not in ['incerto', 'unknown'] %}
                {% if tipo == 'apertura' %}
                  {% if delta_h <= -2.0 or (trend == 'in_calata' and delta_h < 0 and trend_valid) %}
                    {% set esito_15m = 'efficace' %}
                  {% else %}
                    {% set esito_15m = 'inefficace' %}
                  {% endif %}
                {% elif tipo == 'chiusura' %}
                  {% if delta_h <= 0.4 or trend in ['stabile', 'in_calata'] %}
                    {% set esito_15m = 'efficace' %}
                  {% else %}
                    {% set esito_15m = 'inefficace' %}
                  {% endif %}
                {% else %}
                  {% set esito_15m = 'non_valutabile' %}
                {% endif %}
              {% else %}
                {% set esito_15m = 'non_valutabile' %}
              {% endif %}
            {% endif %}
            {% set new_state = esito_15m %}
          {% else %}
            {% set new_state = 'in_attesa' %}
          {% endif %}
        {% else %}
          {% set new_state = 'non_valutabile' %}
        {% endif %}
      {% else %}
        {% set new_state = prev_state %}
      {% endif %}

    {% else %}
      {% set new_state = prev_state %}
    {% endif %}

    {{ new_state }}

    attributes:
      {# ---- Session attributes only (essential for Layer 2 evaluation) ---- #}
      oi: "{{ (ora_inizio_valutazione | string)[-6:] if ora_inizio_valutazione != 'N/A' else 'N/A' }}"
      ta: "{{ 'a' if tipo_azione == 'apertura' else ('c' if tipo_azione == 'chiusura' else 'n') }}"
      cv: "{{ consiglio_valutato[:3] if consiglio_valutato != 'N/A' else 'n/a' }}"
      u0: "{{ (umidita_inizio | round(1) | string) if umidita_inizio != 'N/A' else 'n/a' }}"
      e15: "{{ 'e' if esito_15m == 'efficace' else ('i' if esito_15m == 'inefficace' else 'n') }}"
      e30: "{{ 'e' if esito_30m == 'efficace' else ('i' if esito_30m == 'inefficace' else 'n') }}"
      e60: "{{ 'e' if esito_60m == 'efficace' else ('i' if esito_60m == 'inefficace' else 'n') }}"
      {# ---- Minimal diagnostics (1 only) ---- #}
      dv: "{{ 'p' if primary_data_valid else ('t' if th_data_valid else ('e' if external_data_valid else 'n')) }}"