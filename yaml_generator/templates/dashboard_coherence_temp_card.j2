              - type: custom:mushroom-template-card
                primary: "%%friendly_name%%: {{ states('sensor.fancoil_%%id%%_sensors_coherence_status') }}"
                secondary: >
                  {% set t_th_id = 'sensor.fancoil_%%id%%_temp_delta_th_internal' %}
                  {% set t_knx_id = 'sensor.fancoil_%%id%%_temp_delta_knx_th' %}
                  
                  {{ t_th_id }}: {{ states(t_th_id) }}
                  {{ t_knx_id }}: {{ states(t_knx_id) }}
                entity: binary_sensor.fancoil_%%id%%_sensors_coherence_error
                icon: mdi:thermometer-alert
                icon_color: >
                  {{ 'red' if is_state('binary_sensor.fancoil_%%id%%_sensors_coherence_error', 'on') else 'green' }}
                tap_action:
                  action: more-info
