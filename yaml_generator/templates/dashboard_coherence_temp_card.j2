              - type: custom:mushroom-template-card
                primary: "%%friendly_name%%: {{ states('sensor.fancoil_%%id%%_sensors_coherence_status') }}"
                secondary: >
                  {% set t_th_id = 'sensor.fancoil_%%id%%_temp_delta_th_internal' %}
                  {% set t_knx_id = 'sensor.fancoil_%%id%%_temp_delta_knx_th' %}
                  {% set th = states(t_th_id) %}
                  {% set knx = states(t_knx_id) %}
                  {% set th_change = state_attr(t_th_id, 'delta_change') %}
                  {% set knx_change = state_attr(t_knx_id, 'delta_change') %}
                  TH-Fancoil: {{ th if th not in ['unknown','unavailable'] else 'N/A' }}{{ '°C' if th not in ['unknown','unavailable'] else '' }} | var={{ th_change if th_change is not none else 'N/A' }}
                  KNX-Ref: {{ knx if knx not in ['unknown','unavailable'] else 'N/A' }}{{ '°C' if knx not in ['unknown','unavailable'] else '' }} | var={{ knx_change if knx_change is not none else 'N/A' }}
                entity: binary_sensor.fancoil_%%id%%_sensors_coherence_error
                icon: mdi:thermometer-alert
                icon_color: >
                  {% set st = states('sensor.fancoil_%%id%%_sensors_coherence_status') %}
                  {{ 'red' if is_state('binary_sensor.fancoil_%%id%%_sensors_coherence_error', 'on') else 'grey' if st == 'Nessun confronto' else 'green' }}
                tap_action:
                  action: more-info
