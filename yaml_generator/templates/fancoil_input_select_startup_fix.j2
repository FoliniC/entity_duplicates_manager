# Automation to fix input_select temp_source state on HA startup
# Runs after HA starts to ensure the input_select has a valid value
# (avoids "Current option no longer valid" warnings from restore_state race condition)
- alias: "Fix Fancoil %%friendly_name%% Temp Source on Startup"
  id: fancoil_%%id%%_fix_temp_source_startup
  trigger:
    - platform: homeassistant
      event: start
  action:
    - delay: "00:01:00"
    - service: input_select.select_option
      target:
        entity_id: input_select.fancoil_%%id%%_temp_source
      data:
        option: >
          {% set opts = state_attr('input_select.fancoil_%%id%%_temp_source', 'options') %}
          {{ opts[0] if opts is not none and opts | length > 0 else 'sensor.fancoil_%%id%%_temperature' }}
  mode: single