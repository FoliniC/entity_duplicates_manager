- alias: "%%friendly_name%%: Force Init Temp Source Options"
  trigger:
    - platform: homeassistant
      event: start
  action:
    # 1. Popola le opzioni dalla storia salvata (se valida) o usa i default
    - action: input_select.set_options
      target:
        entity_id: input_select.fancoil_%%id%%_temp_source
      data:
        options: >-
          {% set history = states('sensor.fancoil_%%id%%_temp_sources_history') %}
          {% set defaults = ['sensor.fancoil_%%id%%_temperature'] %}
          {% if "%%ref_sensor%%" != "%%" ~ "ref_sensor" ~ "%%" and "%%ref_sensor%%" != "" %}
            {% set defaults = defaults + ["%%ref_sensor%%"] %}
          {% endif %}
          {% if "%%knx_temp_sensor%%" != "%%" ~ "knx_temp_sensor" ~ "%%" and "%%knx_temp_sensor%%" != "" %}
            {% set defaults = defaults + ["%%knx_temp_sensor%%"] %}
          {% endif %}
          
          {% if history not in ['unavailable', 'unknown', None] and history != "" %}
            {{ history.split(',') }}
          {% else %}
            {{ defaults }}
          {% endif %}
    
    # 2. Ripristina la selezione specifica
    - action: input_select.select_option
      target:
        entity_id: input_select.fancoil_%%id%%_temp_source
      data:
        option: >-
          {% set saved = states('sensor.fancoil_%%id%%_saved_temp_source') %}
          {% if saved not in ['unavailable', 'unknown', None] and saved != "" %}
            {{ saved }}
          {% else %}
            sensor.fancoil_%%id%%_temperature
          {% endif %}

- alias: "%%friendly_name%%: Sync Temp Source Options on Change"
  trigger:
    - platform: state
      entity_id: sensor.fancoil_%%id%%_temp_sources_history
  action:
    - action: input_select.set_options
      target:
        entity_id: input_select.fancoil_%%id%%_temp_source
      data:
        options: "{{ states('sensor.fancoil_%%id%%_temp_sources_history').split(',') }}"

- alias: "%%friendly_name%%: Handle New Sensor Added"
  trigger:
    - platform: state
      entity_id: input_text.fancoil_%%id%%_add_temp_entity
  condition:
    - condition: template
      value_template: "{{ states('input_text.fancoil_%%id%%_add_temp_entity') != '' }}"
  action:
    - action: input_select.select_option
      target:
        entity_id: input_select.fancoil_%%id%%_temp_source
      data:
        option: "{{ states('input_text.fancoil_%%id%%_add_temp_entity') }}"
    - action: input_text.set_value
      target:
        entity_id: input_text.fancoil_%%id%%_add_temp_entity
      data:
        value: ""
