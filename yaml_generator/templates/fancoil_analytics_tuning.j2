# Generated by: %%generator_name%%
# Template: %%template_name%%
# Generated at: %%generation_time%%

# FASE 13 - Dashboard Analytics Tuning per stanza
# Mostra prestazioni del sistema di consiglio finestra con metriche di tuning.
# Compatto: usa card component per ogni metrica, evita layout troppo lunghi.

- title: "Analisi Tuning %%friendly_name%%"
  type: custom:mod-card
  card_mod:
    style: |
      ha-card {
        border: 3px solid #2196F3 !important;
        border-radius: 12px !important;
        padding: 8px !important;
        background: linear-gradient(135deg, #e3f2fd 0%, #fff3e0 100%) !important;
      }
  card:
    type: vertical-stack
    cards:
      - type: grid
        columns: 2
        square: false
        cards:
          # Override Rate
          - type: custom:mushroom-template-card
            primary: "📊 Override Rate"
            secondary: "{{ states('sensor.analytics_tuning_%%id%%') | int(0) }}%"
            entity: sensor.analytics_tuning_%%id%%
            icon: mdi:percent
            icon_color: orange
            tap_action:
              action: more-info
          # Accuracy
          - type: custom:mushroom-template-card
            primary: "🎯 Consigli Corretti"
            secondary: "{{ states('sensor.analytics_tuning_%%id%%', 'attributes') | selectattr('consiglio_accuracy', 'defined') | map(attribute='consiglio_accuracy') | list | first | int(0) }}%"
            entity: sensor.analytics_tuning_%%id%%
            icon: mdi:target
            icon_color: green
            tap_action:
              action: more-info
          
          # Current Status
          - type: custom:mushroom-template-card
            primary: "🔍 Stato Sistema"
            secondary: "{{ 'Verifica OFF' if not is_state('input_boolean.verifica_mode', 'on') else 'Verifica ON' }}"
            entity: input_boolean.verifica_mode
            icon: mdi:shield-check
            icon_color: blue
            tap_action:
              action: toggle
              target:
                entity_id: input_boolean.verifica_mode
          
          # Latest Manual Action
          - type: custom:mushroom-template-card
            primary: "👆 Ultima Azione Manuale"
            secondary: "{{ states('sensor.log_attivita_manuali_%%id%%', 'attributes') | selectattr('azione', 'defined') | map(attribute='azione') | list | first | replace('_', ' ') }}" if states('sensor.log_attivita_manuali_%%id%%') != 'unavailable' else "Nessuna"
            entity: sensor.log_attivita_manuali_%%id%%
            icon: mdi:hand-back-off
            icon_color: purple
            tap_action:
              action: more-info
          
          # Manual Log Count
          - type: custom:mushroom-template-card
            primary: "📝 Azzioni Manuali"
            secondary: "{{ states('sensor.log_attivita_manuali_%%id%%', 'attributes') | selectattr('azione', 'defined') | map(attribute='azione') | list | length }} azioni"
            entity: sensor.log_attivita_manuali_%%id%%
            icon: mdi:counter
            icon_color: amber
            tap_action:
              action: more-info
          
          # Window State
          - type: custom:mushroom-template-card
            primary: "🪟 Stato Finestra"
            secondary: >-
              {% if window_contact_sensor %}
                {{ 'APERTA' if is_state(window_contact_sensor, 'on') else 'CHIUSA' }}
              {% else %}
                {{ 'APERTA' if is_state('input_boolean.finestra_%%id%%_aperta', 'on') else 'CHIUSA' }}
              {% endif %}
            entity: >-
              {% if window_contact_sensor %}
                {{ window_contact_sensor }}
              {% else %}
                input_boolean.finestra_%%id%%_aperta
              {% endif %}
            icon: mdi:window-open
            icon_color: orange
            tap_action:
              action: toggle
              target:
                entity_id: >-
                  {% if window_contact_sensor %}
                    {{ window_contact_sensor }}
                  {% else %}
                    input_boolean.finestra_%%id%%_aperta
                  {% endif %}
          
          # Consiglia Attuale
          - type: custom:mushroom-template-card
            primary: "💡 Consiglia Sistema"
            secondary: "{{ states('sensor.consiglio_finestra_%%id%%') }}"
            entity: sensor.consiglio_finestra_%%id%%
            icon: mdi:lightbulb
            icon_color: yellow
            tap_action:
              action: more-info
          
          # Trend
          - type: custom:mushroom-template-card
            primary: "📈 Trend Humidità"
            secondary: "{{ states('sensor.trend_umidita_%%id%%') }}"
            entity: sensor.trend_umidita_%%id%%
            icon: mdi:trending-up
            icon_color: teal
            tap_action:
              action: more-info