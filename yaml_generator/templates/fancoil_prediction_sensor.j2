# Trigger-based prediction sensor (per room)
# Generated by: yaml_generator/generate_fancoil_climates.py
# Template: fancoil_prediction_sensor.j2
# Room: %%friendly_name%% (%%id%%)
#
# v5 - correzioni rispetto a euristico_v4:
#  - ESPONE 'predicted_humidity' e 'humidity_delta_predicted': il consiglio finestra, il logger e
#    la valutazione d'esito li leggono. Senza, calo_umidita_previsto vale 0 e l'albero non puo' mai
#    consigliare 'apri' (richiede un calo previsto >= 4 o 6 punti).
#  - Tutto e' calcolato UNA volta nel blocco variables: prima gli attributi si rileggevano da
#    sensor.previsione_finestra_<id> (se stessi) con un minuto di ritardo e dipendevano dal nome
#    esatto dell'entita'.
#  - Conversione omega -> RH fisica: punti RH per g/kg = 100 / omega_saturazione(T) (~6.8-7.2 a 20-21 C),
#    al posto del 10.0 fisso, che sovrastimava il calo (T-dipendente, non costante).
#  - Plausibilita' degli ingressi (T 5-40 C, RH 5-100 %, omega 1-25 g/kg, esterno 0-25 g/kg).
#  - Lo stato e' breve (limite 255 caratteri); il testo lungo sta in 'prediction_text'.
#  - tau_min = costante di tempo del ricambio. Con 3 aperture reali stimo: Cucina <= 3 min,
#    Bagno ~ 3 min, Camera Grande ~ 14 min (stanza che si svuota piu' lentamente). Regolare per stanza.

trigger:
  - platform: time_pattern
    minutes: "/1"
sensor:
  - name: "Previsione Finestra %%friendly_name%%"
    unique_id: previsione_finestra_%%id%%
    variables:
      tau_min: >-
        {% if "%%id%%" == "camera_grande" %}14.0
        {% elif "%%id%%" in ["cucina", "bagno"] %}3.0
        {% else %}4.0{% endif %}
      p_hpa: 980
      rh_p: "{{ states('sensor.umidita_%%id%%_pilota') | float(none) }}"
      rh_f: "{{ states('sensor.fancoil_%%id%%_humidity') | float(none) }}"
      rh_raw_in: >-
        {% set v = rh_p if rh_p is not none and rh_p > 0 else rh_f %}
        {{ v if v is not none and 5 <= v <= 100 else none }}
      t_p: "{{ states('sensor.temperatura_%%id%%_reale_calcolata') | float(none) }}"
      t_f: "{{ states('sensor.fancoil_%%id%%_temperature') | float(none) }}"
      temp: >-
        {% set v = t_p if t_p is not none and t_p != 0 else t_f %}
        {{ v if v is not none and 5 <= v <= 40 else none }}
      omega_in: >-
        {% set v = states('sensor.omega_%%id%%') | float(none) %}
        {{ v if v is not none and 1 <= v <= 25 else none }}
      omega_ext: >-
        {% set v = states('sensor.omega_esterno') | float(none) %}
        {% set te = state_attr('sensor.omega_esterno', 'temperatura') | float(none) %}
        {{ v if v is not none and 0 < v < 25 and (te is none or -30 < te < 45) else none }}
      temp_ext: "{{ state_attr('sensor.omega_esterno', 'temperatura') | float(none) }}"
      ext_rh: "{{ state_attr('sensor.omega_esterno', 'umidita') | float(none) }}"
      factor_rh: "{{ state_attr('sensor.analytics_tuning_%%id%%', 'prediction_factor_humidity') | float(1.0) }}"
      factor_temp: "{{ state_attr('sensor.analytics_tuning_%%id%%', 'prediction_factor_temperature') | float(1.0) }}"
      horizon: >-
        {% set h = state_attr('sensor.consiglio_finestra_%%id%%', 'durata_apertura_consigliata_minuti') | int(10) %}
        {{ 5 if h < 5 else (45 if h > 45 else h) }}
      exchange_fraction_v: "{{ 1 - (2.718281828459 ** (0 - (horizon / tau_min))) }}"
      # punti di RH per ogni g/kg di omega, alla temperatura della stanza (Magnus)
      k_rh: >-
        {% if temp is none %}7.0
        {% else %}
          {% set es = 6.112 * (2.718281828459 ** (17.62 * temp / (243.12 + temp))) %}
          {{ 100.0 / (622.0 * es / (p_hpa - es)) }}
        {% endif %}
      rh_pred: >-
        {% if rh_raw_in is none or omega_in is none or omega_ext is none %}{{ none }}
        {% else %}
          {% set pot = (omega_in - omega_ext) * k_rh * factor_rh %}
          {% set raw = rh_raw_in - (pot * exchange_fraction_v) %}
          {% if (omega_in is not none and omega_ext is not none and omega_in > omega_ext) or (ext_rh is not none and ext_rh < rh_raw_in) %}
            {% set raw = [raw, rh_raw_in] | min %}
          {% elif (omega_in is not none and omega_ext is not none and omega_in < omega_ext) or (ext_rh is not none and ext_rh > rh_raw_in) %}
            {% set raw = [raw, rh_raw_in] | max %}
          {% endif %}
          {{ 30 if raw < 30 else (95 if raw > 95 else raw) }}
        {% endif %}
      hvac_mode_v: >-
        {% set raw_mode = states('sensor.fancoil_%%id%%_hvac_temp_mode') %}
        {% set climate_mode = states('climate.controllo_temperatura_%%id%%') %}
        {{ raw_mode if raw_mode in ['heat', 'cool', 'dry'] else climate_mode }}
      setpoint: "{{ state_attr('climate.controllo_temperatura_%%id%%', 'temperature') | float(states('input_number.fancoil_%%id%%_setpoint') | float(none)) }}"
      temp_pred: >-
        {% if temp is none %}{{ none }}
        {% else %}
          {% set gap = (temp_ext - temp) if temp_ext is not none else 0 %}
          {% set fr = exchange_fraction_v * factor_temp %}
          {% set frac = 0.05 if fr < 0.05 else (0.95 if fr > 0.95 else fr) %}
          {% set tw = temp + (gap * frac) %}
          {% set s_raw = 1 - (2.718281828459 ** (0 - (horizon / 24))) %}
          {% set s = 0.9 if s_raw > 0.9 else s_raw %}
          {% if hvac_mode_v == 'cool' and setpoint is not none and tw > setpoint %}{{ tw - ((tw - setpoint) * s) }}
          {% elif hvac_mode_v == 'heat' and setpoint is not none and tw < setpoint %}{{ tw + ((setpoint - tw) * s) }}
          {% elif hvac_mode_v == 'dry' and setpoint is not none and tw > setpoint %}{{ tw - ((tw - setpoint) * (s * 0.65)) }}
          {% else %}{{ tw }}{% endif %}
        {% endif %}
      testo: >-
        {% if rh_raw_in is none or temp is none or rh_pred is none or temp_pred is none %}Dati insufficienti per la previsione.
        {% else %}Se apri la finestra, tra circa {{ horizon }} minuti l'umidita passera da {{ rh_raw_in | round(0) }}% a {{ rh_pred | round(0) }}% e la temperatura da {{ temp | round(1) }}C a {{ temp_pred | round(1) }}C. Oltre questo tempo il ricambio dovrebbe essere vicino alla stabilizzazione.{% endif %}
    state: >-
      {% if rh_raw_in is none or rh_pred is none %}dati_insufficienti{% else %}{{ rh_raw_in | round(0) }}% -> {{ rh_pred | round(0) }}% in {{ horizon }} min{% endif %}
    icon: mdi:chart-timeline-variant-shimmer
    attributes:
      model_version: "euristico_v5_k_rh_fisico_tau_per_stanza"
      horizon_minutes: "{{ horizon }}"
      tau_min: "{{ tau_min }}"
      predicted_humidity: "{{ rh_pred | round(1) if rh_pred is not none else '' }}"
      humidity_delta_predicted: "{{ (rh_pred - rh_raw_in) | round(1) if rh_pred is not none and rh_raw_in is not none else '' }}"
      predicted_temperature: "{{ temp_pred | round(1) if temp_pred is not none else '' }}"
      temperature_delta_predicted: "{{ (temp_pred - temp) | round(1) if temp_pred is not none and temp is not none else '' }}"
      external_source: "{{ state_attr('sensor.omega_esterno', 'source') | default('') }}"
      external_temperature: "{{ temp_ext | round(1) if temp_ext is not none else '' }}"
      external_humidity: "{{ ext_rh | round(1) if ext_rh is not none else '' }}"
      hvac_mode: "{{ hvac_mode_v }}"
      hvac_setpoint: "{{ setpoint if setpoint is not none else '' }}"
      hvac_active_for_prediction: "{{ hvac_mode_v in ['heat', 'cool', 'dry'] and setpoint is not none }}"
      delta_omega: "{{ (omega_in - omega_ext) | round(2) if omega_in is not none and omega_ext is not none else '' }}"
      exchange_fraction: "{{ exchange_fraction_v | round(3) }}"
      k_rh_per_gkg: "{{ k_rh | round(2) }}"
      prediction_factor_humidity: "{{ factor_rh }}"
      prediction_factor_temperature: "{{ factor_temp }}"
      prediction_factor_time: "{{ state_attr('sensor.analytics_tuning_%%id%%', 'prediction_factor_time') | float(1.0) }}"
      prediction_text: "{{ testo | trim }}"