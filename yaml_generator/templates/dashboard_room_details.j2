# Generated by: %%generator_name%%
# Template: %%template_name%%
# Generated at: %%generation_time%%

  - title: "Dettagli %%friendly_name%%"
    path: "fancoil-dettagli-%%id%%"
    subview: true
    cards:
      - type: vertical-stack
        cards:
          - type: thermostat
            entity: climate.controllo_temperatura_%%id%%
            name: %%friendly_name%%
            features:
              - type: climate-hvac-modes
                hvac_modes:
                  - 'off'
                  - cool
                  - heat
                  - dry
                  - fan_only
          
          - type: entities
            title: Configurazione Sorgente Temperatura
            show_header_toggle: false
            entities:
              - entity: input_select.fancoil_%%id%%_temp_source
                name: Sorgente attiva
                icon: mdi:thermometer-lines
              - entity: input_text.fancoil_%%id%%_add_temp_entity
                name: Aggiungi/Cambia Sensore (ID)
                placeholder: "es: sensor.stanza_th"
              - entity: sensor.temperatura_%%id%%_reale_calcolata
                name: Temperatura Letta
                icon: mdi:thermometer-check
                style: |
                  :host { --paper-item-icon-color: green; font-weight: bold; }

          - type: entities
            title: Stato Fan Coil e Velocità
            show_header_toggle: false
            entities:
              - entity: switch.fancoil_%%id%%_switch_4
                name: Valvola / Motore
                icon: mdi:power
              - entity: switch.fancoil_%%id%%_switch_1
                name: Velocità 1 (Low)
                icon: mdi:fan-speed-1
              - entity: switch.fancoil_%%id%%_switch_2
                name: Velocità 2 (Med)
                icon: mdi:fan-speed-2
              - entity: switch.fancoil_%%id%%_switch_3
                name: Velocità 3 (High)
                icon: mdi:fan-speed-3
              - entity: sensor.fancoil_%%id%%_status_comunicazione
                name: Diagnostica Hardware

          - type: entities
            title: Configurazione Automazione
            show_header_toggle: false
            entities:
              - entity: input_boolean.fancoil_%%id%%_sp_follow_master
                name: Segue setpoint Master
                icon: mdi:link-variant
              - entity: input_boolean.fancoil_%%id%%_hvac_mode_follow_master
                name: Segue modalità Master
                icon: mdi:link-variant
              - entity: input_boolean.fancoil_%%id%%_logging_follow_master
                name: Segue logging Master
                icon: mdi:link-variant
              - entity: input_boolean.fancoil_%%id%%_logging_enabled
                name: Logging Locale Abilitato
                icon: mdi:file-document-outline

          {% if window_contact_sensor %}
          - type: entities
            title: Stato Finestra
            show_header_toggle: false
            entities:
              - entity: %%window_contact_sensor%%
                name: Contatto Finestra
                icon: mdi:window-open
                device_class: door
          {% endif %}

          - type: vertical-stack
            title: Offset Rispetto al Master
            cards:
              - type: horizontal-stack
                cards:
                  - type: custom:mushroom-template-card
                    icon: mdi:minus
                    layout: vertical
                    card_mod:
                      style: |
                        ha-card {
                          width: 40px;
                          box-shadow: none;
                          border: none;
                        }
                    tap_action:
                      action: call-service
                      service: input_number.decrement
                      target:
                        entity_id: input_number.fancoil_%%id%%_sp_offset
                  - type: custom:mushroom-number-card
                    entity: input_number.fancoil_%%id%%_sp_offset
                    display_mode: slider
                    layout: horizontal
                    primary_info: state
                    secondary_info: none
                    double_tap_action:
                      action: call-service
                      service: input_number.set_value
                      target:
                        entity_id: input_number.fancoil_%%id%%_sp_offset
                      data:
                        value: 0
                    card_mod:
                      style: |
                        ha-card {
                          flex-grow: 1;
                        }
                        :host {
                          --mushroom-icon-display: none !important;
                        }
                        mushroom-shape-icon {
                          display: none !important;
                          visibility: hidden !important;
                          opacity: 0 !important;
                        }
                  - type: custom:mushroom-template-card
                    icon: mdi:plus
                    layout: vertical
                    card_mod:
                      style: |
                        ha-card {
                          width: 40px;
                          box-shadow: none;
                          border: none;
                        }
                    tap_action:
                      action: call-service
                      service: input_number.increment
                      target:
                        entity_id: input_number.fancoil_%%id%%_sp_offset
          
          - type: button
            name: Torna Indietro
            icon: mdi:arrow-left
            tap_action:
              action: navigate
              navigation_path: /riscaldamento-1/riscaldamento