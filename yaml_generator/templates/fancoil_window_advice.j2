# Generated by: %%generator_name%%
# Template: %%template_name%%
# Generated at: %%generation_time%%

# FASE 6 - Consiglio apertura/chiusura finestre per stanza
# Trigger-based template con variables: la logica decisionale e` calcolata UNA VOLTA
# nel blocco variables e riusata da state, icon e attributes senza duplicazione.
# CORREZIONE: prima il consiglio si ricalcolava a ogni variazione di 8 sensori (centinaia di
# cambi di stato al giorno, mediana 4-15 s). Ora si valuta ogni minuto + subito alla pioggia;
# il cambio di stato richiede una permanenza minima (debounce) per evitare i glitch.
trigger:
  - platform: state
    entity_id: sensor.castionetto_precipitazione
  - platform: time_pattern
    minutes: "/1"
sensor:
  - name: "Consiglio Finestra %%friendly_name%%"
    unique_id: consiglio_finestra_%%id%%
    variables:
      has_window: %%HAS_WINDOW%%
      window_contact_sensor: %%WINDOW_CONTACT_SENSOR%%
      t_int: >-
        {% set primary = states('sensor.temperatura_%%id%%_reale_calcolata') %}
        {% set fallback = states('sensor.fancoil_%%id%%_temperature') %}
        {{ primary if is_number(primary) and primary | float(0) != 0 else fallback }}
      rh_int: >-
        {% set primary = states('sensor.umidita_%%id%%_pilota') %}
        {% set fallback = states('sensor.fancoil_%%id%%_humidity') %}
        {{ primary if is_number(primary) and primary | float(0) > 0 else fallback }}
      omega_int: "{{ states('sensor.omega_%%id%%') | float(none) }}"
      omega_ext: "{{ states('sensor.omega_esterno') | float(none) }}"
      trend: "{{ states('sensor.trend_umidita_%%id%%') }}"
      # --- memoria dal ciclo precedente (stato e attributi di questo stesso sensore) ---
      self_id: sensor.consiglio_finestra_%%id%%
      stato_prec: >-
        {% set s = states(self_id) %}
        {{ s if s not in ['unknown', 'unavailable', 'none', ''] else 'nessuna_azione' }}
      finestra_prec: "{{ state_attr(self_id, 'finestra_aperta') | string | trim | lower == 'true' }}"
      cand_prec: "{{ state_attr(self_id, 'candidato') | default('', true) | string | trim }}"
      cand_da_prec: "{{ state_attr(self_id, 'candidato_da') | float(0) }}"
      finestra_da_prec: "{{ state_attr(self_id, 'finestra_da') | float(0) }}"
      debounce_s: 300   # secondi; allineato alla notifica (for: 5 min). Con 120 s restavano oscillazioni da ~3 min
      # CORREZIONE: se il contatto e` unavailable/unknown NON si assume "chiusa": si mantiene
      # l'ultimo stato valido (prima: is_state(...,'on') dava false e azzerava minuti_aperta).
      finestra_aperta: >-
        {% if has_window != true %}false
        {% elif window_contact_sensor and states(window_contact_sensor) in ['on', 'off'] %}
          {{ is_state(window_contact_sensor, 'on') }}
        {% elif window_contact_sensor %}
          {{ finestra_prec }}
        {% else %}
          {{ is_state('input_boolean.finestra_%%id%%_aperta', 'on') }}
        {% endif %}
      finestra_da: >-
        {% set aperta = finestra_aperta | string | trim | lower == 'true' %}
        {% set prec = finestra_prec | string | trim | lower == 'true' %}
        {% if aperta != prec or finestra_da_prec | float(0) == 0 %}{{ now().timestamp() }}{% else %}{{ finestra_da_prec }}{% endif %}
      minuti_aperta: >-
        {% if has_window != true %}0
        {% elif finestra_aperta | string | trim | lower == 'true' %}
          {{ ((now().timestamp() - finestra_da | float(0)) / 60) | round(0) }}
        {% else %}0{% endif %}
      piove: "{{ states('sensor.castionetto_precipitazione') | float(0) > 0.0 }}"
      fancoil_attivo: "{{ is_state('switch.fancoil_%%id%%_switch_1', 'on') or is_state('switch.fancoil_%%id%%_switch_2', 'on') or is_state('switch.fancoil_%%id%%_switch_3', 'on') or is_state('switch.fancoil_%%id%%_switch_4', 'on') }}"
      impianto_attivo: >-
        {% set action = state_attr('climate.controllo_temperatura_%%id%%', 'hvac_action') %}
        {{ is_state('switch.fancoil_%%id%%_switch_1', 'on') or is_state('switch.fancoil_%%id%%_switch_2', 'on') or is_state('switch.fancoil_%%id%%_switch_3', 'on') or is_state('switch.fancoil_%%id%%_switch_4', 'on')
           or action in ['cooling', 'heating', 'drying'] }}
      # CORREZIONE: plausibilita' dei dati (T 10-35 C, RH 10-95 %, omega interna 1-20 g/kg,
      # esterno omega 0-25 g/kg e T -30..45 C). Prima valori impossibili (T_ext 97 C, omega 1166)
      # entravano nell'albero.
      ext_ok: >-
        {% set w = states('sensor.omega_esterno') %}
        {% set te = state_attr('sensor.omega_esterno', 'temperatura') %}
        {{ is_number(w) and 0 < (w | float(0)) < 25 and (not is_number(te) or -30 < (te | float(0)) < 45) }}
      dati_validi: >-
        {% set t_p = states('sensor.temperatura_%%id%%_reale_calcolata') %}
        {% set t_f = states('sensor.fancoil_%%id%%_temperature') %}
        {% set r_p = states('sensor.umidita_%%id%%_pilota') %}
        {% set r_f = states('sensor.fancoil_%%id%%_humidity') %}
        {% set t = t_p if is_number(t_p) and t_p | float(0) != 0 else t_f %}
        {% set r = r_p if is_number(r_p) and r_p | float(0) > 0 else r_f %}
        {% set w = states('sensor.omega_%%id%%') %}
        {{ is_number(t) and 10 <= (t | float(0)) <= 35
           and is_number(r) and 10 <= (r | float(0)) <= 95
           and is_number(w) and 1 <= (w | float(0)) <= 20
           and ext_ok | string | trim | lower == 'true' }}
      delta_omega: >-
        {% set omega_room = states('sensor.omega_%%id%%') %}
        {% set omega_out = states('sensor.omega_esterno') %}
        {{ (omega_room | float(0) - omega_out | float(0)) if is_number(omega_room) and is_number(omega_out) and ext_ok | string | trim | lower == 'true' else none }}
      calo_umidita_previsto: >-
        {% set predicted = state_attr('sensor.previsione_finestra_%%id%%', 'predicted_humidity') | float(none) %}
        {% set rh_primary = states('sensor.umidita_%%id%%_pilota') | float(none) %}
        {% set rh_fallback = states('sensor.fancoil_%%id%%_humidity') | float(none) %}
        {% set rh = rh_primary if rh_primary is not none and rh_primary > 0 else rh_fallback %}
        {{ (rh - predicted) if rh is not none and predicted is not none else none }}
      # azione_raw e` il risultato grezzo dell'albero decisionale, valutato una volta sola
      azione_raw: >
        {% set has_win = has_window | default(true) %}
        {% set valid = dati_validi | string | trim | lower == 'true' %}
        {% set window_open = finestra_aperta | string | trim | lower == 'true' %}
        {% set rain = piove | string | trim | lower == 'true' %}
        {% set system_active = impianto_attivo | string | trim | lower == 'true' %}
        {% set rh = rh_int | float(0) %}
        {% set delta = delta_omega | float(0) %}
        {% set rh_drop = calo_umidita_previsto | float(0) %}
        {% set minuti = minuti_aperta | int(0) %}
        {% if not valid %}incerto
        {% elif not has_win %}
          {# Stanza senza finestra: nessuna azione su finestra, solo info #}
          {% if delta >= 1.5 and rh_drop >= 4.0 and rh > 58.0 %}apri_porte_ricambio
          {% elif delta < 0.2 %}chiudi_porte
          {% else %}nessuna_azione{% endif %}
        {% elif window_open %}
          {%- if rain %}chiudi
          {%- elif trend == 'in_salita' %}chiudi
          {%- elif system_active and minuti >= 8 %}chiudi
          {%- elif system_active and minuti >= 5 and not (trend == 'in_calata' and delta >= 2.5 and rh_drop >= 6.0 and rh > 62.0) %}chiudi
          {%- elif delta < 0.2 %}chiudi
          {%- elif rh <= 55.0 %}chiudi
          {%- elif trend == 'stabile' and minuti >= 12 %}chiudi
          {%- elif trend in ['incerto', 'unknown', 'unavailable'] and minuti >= 20 %}chiudi
          {%- elif trend == 'in_calata' and not system_active and rh > 58.0 and delta >= 1.5 and rh_drop >= 4.0 and minuti < 12 %}mantieni_aperta
          {%- elif trend == 'in_calata' and system_active and rh > 62.0 and delta >= 2.5 and rh_drop >= 6.0 and minuti < 8 %}mantieni_aperta
          {%- else %}nessuna_azione{% endif %}
        {% else %}
          {%- if rain %}
            {%- if (system_active and delta >= 2.8 and rh_drop >= 6.0 and rh > 62.0) or (not system_active and delta >= 1.8 and rh_drop >= 4.0 and rh > 58.0) %}apri_se_riparata
            {%- else %}mantieni_chiusa{% endif %}
          {%- elif system_active and delta >= 2.5 and rh_drop >= 6.0 and rh > 62.0 %}apri
          {%- elif not system_active and delta >= 1.5 and rh_drop >= 4.0 and rh > 58.0 %}apri
          {%- elif delta < 0.2 %}mantieni_chiusa
          {%- else %}nessuna_azione{% endif %}
        {% endif %}
      # CORREZIONE: debounce. Il nuovo consiglio diventa effettivo solo se resta lo stesso per
      # almeno debounce_s secondi (candidato). Eccezioni:
      # - pioggia con finestra aperta -> chiudi subito
      # - cambio stato finestra (aperta/chiusa) -> aggiorna subito, e' un'azione deliberata
      # - primo avvio (il sensore non ha ancora uno stato valido) -> nessuna attesa
      #   ATTENZIONE: "primo avvio" NON va definito come "nessun candidato in corso": quella e' la
      #   condizione normale a ogni prima comparsa di un nuovo valore e annullerebbe il debounce.
      azione: >-
        {% set raw = azione_raw | trim %}
        {% set prev = stato_prec | trim %}
        {% set rain = piove | string | trim | lower == 'true' %}
        {% set aperta = finestra_aperta | string | trim | lower == 'true' %}
        {% set finestra_cambiata = aperta != (finestra_prec | string | trim | lower == 'true') %}
        {% set primo_avvio = states(self_id) in ['unknown', 'unavailable', 'none', ''] %}
        {% set matura = cand_prec == raw and (now().timestamp() - cand_da_prec | float(0)) >= (debounce_s - 5) %}
        {% if raw == prev %}{{ raw }}
        {% elif rain and aperta and raw == 'chiudi' %}{{ raw }}
        {% elif finestra_cambiata %}{{ raw }}
        {% elif primo_avvio %}{{ raw }}
        {% elif matura %}{{ raw }}
        {% else %}{{ prev }}{% endif %}
      cand_new: >-
        {% set raw = azione_raw | trim %}
        {{ raw if raw != (azione | trim) else '' }}
      cand_da_new: >-
        {% if cand_new | string | trim == '' %}0
        {% elif cand_new | string | trim == cand_prec %}{{ cand_da_prec }}
        {% else %}{{ now().timestamp() }}{% endif %}
    state: "{{ azione | trim }}"
    icon: >
      {% set has_win = has_window | default(true) %}
      {% set action = azione | trim %}
      {% if action == 'incerto' %}mdi:help-circle-outline
      {% elif not has_win %}
        {% if action in ['apri_porte_ricambio'] %}mdi:door-open
        {% elif action in ['chiudi_porte'] %}mdi:door-closed
        {% else %}mdi:door{% endif %}
      {% elif action == 'apri' %}mdi:window-open-variant
      {% elif action == 'apri_se_riparata' %}mdi:window-open-variant
      {% elif action == 'chiudi' %}mdi:window-closed-variant
      {% elif action == 'mantieni_aperta' %}mdi:window-open
      {% else %}mdi:window-closed
      {% endif %}
    attributes:
      delta_omega: "{{ delta_omega if delta_omega is not none else 'none' }}"
      calo_umidita_previsto: "{{ calo_umidita_previsto if calo_umidita_previsto is not none else 'none' }}"
      trend_umidita: "{{ trend }}"
      finestra_aperta: "{{ finestra_aperta }}"
      minuti_aperta: "{{ minuti_aperta }}"
      impianto_attivo: "{{ impianto_attivo }}"
      has_window: "{{ has_window }}"
      azione_raw: "{{ azione_raw | trim }}"
      candidato: "{{ cand_new | string | trim }}"
      candidato_da: "{{ cand_da_new | trim }}"
      finestra_da: "{{ finestra_da | trim }}"
      dati_ext_validi: "{{ ext_ok | trim }}"
      apertura_breve: >-
        {% set action = azione | trim %}
        {% set system_active = impianto_attivo | string | trim | lower == 'true' %}
        {{ action in ['apri', 'apri_se_riparata', 'mantieni_aperta'] and system_active }}
      durata_apertura_consigliata_minuti: >-
        {% set action = azione | trim %}
        {% set system_active = impianto_attivo | string | trim | lower == 'true' %}
        {% set delta = delta_omega | float(0) %}
        {% if action in ['apri', 'apri_se_riparata'] %}
          {% if system_active %}5{% elif delta >= 2.5 %}10{% else %}8{% endif %}
        {% elif action == 'mantieni_aperta' %}
          {% if system_active %}8{% else %}12{% endif %}
        {% else %}
          0
        {% endif %}
      confidenza: >
        {% set valid = dati_validi | string | trim | lower == 'true' %}
        {% set window_open = finestra_aperta | string | trim | lower == 'true' %}
        {% set delta = delta_omega | float(0) %}
        {% if not valid %}0{% else %}
        {% set base_conf = 100 %}
        {% if impianto_attivo | string | trim | lower == 'true' and window_open %}
          {% set base_conf = base_conf - 30 %}
        {% endif %}
        {% if delta | abs < 0.2 %}
          {% set base_conf = base_conf - 10 %}
        {% endif %}
        {{ base_conf }}{% endif %}
      motivo: >
        {% set valid = dati_validi | string | trim | lower == 'true' %}
        {% set window_open = finestra_aperta | string | trim | lower == 'true' %}
        {% set rain = piove | string | trim | lower == 'true' %}
        {% set system_active = impianto_attivo | string | trim | lower == 'true' %}
        {% set rh = rh_int | float(0) %}
        {% set delta = delta_omega | float(0) %}
        {% set rh_drop = calo_umidita_previsto | float(0) %}
        {% set minuti = minuti_aperta | int(0) %}
        {% set action = azione | trim %}
        {% if not valid %}Dati sensori non completi o non disponibili.
        {% else %}
        {% set ns = namespace(motivi=[]) %}
        {% if rain %}
          {% set ns.motivi = ns.motivi + ['Rilevata pioggia all\'esterno. Chiudere la finestra per evitare infiltrazioni.'] %}
        {% endif %}
        {% if action == 'apri' %}
          {% if system_active %}
            {% set ns.motivi = ns.motivi + ['Impianto attivo: apertura ammessa solo per ricambio breve. Umidita` interna elevata (' ~ rh | round(1) ~ '%), calo previsto ' ~ rh_drop | round(1) ~ ' punti e aria esterna molto piu` secca (delta: ' ~ delta | round(2) ~ ' g/kg). Aprire per circa 5 minuti, poi chiudere.'] %}
          {% else %}
            {% set ns.motivi = ns.motivi + ['Umidita` interna elevata (' ~ rh | round(1) ~ '%), calo previsto ' ~ rh_drop | round(1) ~ ' punti e aria esterna secca (delta: ' ~ delta | round(2) ~ ' g/kg). Aprire per un ricambio breve, poi rivalutare.'] %}
          {% endif %}
        {% elif action == 'apri_se_riparata' %}
          {% if system_active %}
            {% set ns.motivi = ns.motivi + ['Pioggia rilevata e impianto attivo: aprire solo se riparata e solo per circa 5 minuti, perche` il calo previsto e` importante (' ~ rh_drop | round(1) ~ ' punti) e l\'aria esterna e` molto piu` secca (delta: ' ~ delta | round(2) ~ ' g/kg).'] %}
          {% else %}
            {% set ns.motivi = ns.motivi + ['Pioggia rilevata ma calo previsto importante (' ~ rh_drop | round(1) ~ ' punti) e aria esterna molto secca (delta: ' ~ delta | round(2) ~ ' g/kg). Se la finestra e\' riparata dalla pioggia, aprire per un ricambio breve.'] %}
          {% endif %}
        {% elif action == 'chiudi' and window_open %}
          {% if trend == 'in_salita' %}
            {% set ns.motivi = ns.motivi + ['L\'umidita` interna sta aumentando (trend in salita) nonostante la finestra aperta. Il ricambio reale non sta migliorando la stanza: chiudere.'] %}
          {% elif system_active and minuti >= 8 %}
            {% set ns.motivi = ns.motivi + ['Impianto attivo e finestra aperta da circa ' ~ minuti ~ ' minuti. Il ricambio utile deve restare breve per non disperdere fresco/caldo: chiudere.'] %}
          {% elif system_active and minuti >= 5 %}
            {% set ns.motivi = ns.motivi + ['Impianto attivo e beneficio non eccezionale: dopo circa ' ~ minuti ~ ' minuti conviene chiudere per non contrastare il fancoil.'] %}
          {% elif delta < 0.2 %}
            {% set ns.motivi = ns.motivi + ['L\'aria esterna e` piu` umida o uguale a quella interna (delta: ' ~ delta | round(2) ~ ' g/kg). Si consiglia di chiudere.'] %}
          {% elif rh <= 55.0 %}
            {% set ns.motivi = ns.motivi + ['Umidita` interna a livello ottimale (' ~ rh | round(1) ~ '%). Chiudere per evitare dispersione termica.'] %}
          {% elif trend == 'stabile' and minuti >= 12 %}
            {% set ns.motivi = ns.motivi + ['Umidita` stabilizzata dopo circa ' ~ minuti ~ ' minuti di apertura. Il ricambio utile e` esaurito: chiudere.'] %}
          {% elif trend in ['incerto', 'unknown', 'unavailable'] and minuti >= 20 %}
            {% set ns.motivi = ns.motivi + ['Trend non affidabile ma finestra aperta da circa ' ~ minuti ~ ' minuti. Chiudere per evitare ricambio e dispersione non necessari.'] %}
          {% else %}
            {% set ns.motivi = ns.motivi + ['Condizioni non favorevoli. Si consiglia di chiudere.'] %}
          {% endif %}
        {% elif action == 'mantieni_aperta' %}
          {% if trend == 'in_calata' %}
            {% if system_active %}
              {% set ns.motivi = ns.motivi + ['L\'umidita` interna e` in calo e il beneficio e` forte. Mantenere aperta solo fino a circa 8 minuti totali, poi chiudere per non contrastare l\'impianto.'] %}
            {% else %}
              {% set ns.motivi = ns.motivi + ['L\'umidita` interna e` in calo (trend in calata). Mantenere la finestra aperta ancora per poco, poi rivalutare.'] %}
            {% endif %}
          {% elif delta >= 1.0 %}
            {% set ns.motivi = ns.motivi + ['L\'aria esterna e` significativamente piu` secca (delta: ' ~ delta | round(2) ~ ' g/kg). Mantenere aperta solo per ricambio breve.'] %}
          {% else %}
            {% set ns.motivi = ns.motivi + ['Umidita` interna stabile. Nessuna azione necessaria.'] %}
          {% endif %}
        {% elif action in ['mantieni_chiusa', 'nessuna_azione'] %}
          {% if not rain and delta < 0.2 %}
            {% set ns.motivi = ns.motivi + ['L\'aria esterna e` piu` umida o uguale (delta: ' ~ delta | round(2) ~ ' g/kg). Mantenere la finestra chiusa.'] %}
          {% elif system_active and delta < 2.5 %}
            {% set ns.motivi = ns.motivi + ['Impianto attivo: beneficio di deumidificazione non abbastanza alto (delta: ' ~ delta | round(2) ~ ' g/kg, calo previsto ' ~ rh_drop | round(1) ~ ' punti). Meglio tenere chiuso per non disperdere fresco/caldo.'] %}
          {% elif not rain %}
            {% set ns.motivi = ns.motivi + ['Nessuna azione necessaria. Condizioni di umidita` accettabili.'] %}
          {% endif %}
        {% elif action == 'apri_porte_ricambio' %}
          {% set ns.motivi = ns.motivi + ['Corridoio: apertura porte verso stanze Est/Ovest per creare corrente d\'aria trasversale. Umidita` interna ' ~ rh | round(1) ~ '%, calo previsto ' ~ rh_drop | round(1) ~ ' punti, delta omega ' ~ delta | round(2) ~ ' g/kg.'] %}
        {% elif action == 'chiudi_porte' %}
          {% set ns.motivi = ns.motivi + ['Corridoio: chiudere le porte. Aria esterna piu` umida o uguale (delta: ' ~ delta | round(2) ~ ' g/kg). Nessun ricambio utile.'] %}
        {% endif %}
        {% if has_window | default(true) and system_active and window_open %}
          {% set ns.motivi = ns.motivi + ['ATTENZIONE: Conflitto energetico! Il fancoil e` attivo mentre la finestra e` aperta.'] %}
        {% endif %}
        {{ ns.motivi | join(' ') }}{% endif %}