# Generated by: %%generator_name%%
# Template: %%template_name%%
# Generated at: %%generation_time%%

# FASE 7 - Notifiche persistenti consiglio finestra
# Si attiva quando il consiglio finestra cambia e rimane stabile per 5 minuti.
# Invia una persistent_notification con contesto completo.
# La notifica viene rimossa quando il consiglio torna a nessuna_azione/incerto.

- alias: "%%friendly_name%%: Notifica Consiglio Finestra"
  id: notifica_consiglio_finestra_%%id%%
  trigger:
    - platform: state
      entity_id: sensor.consiglio_finestra_%%id%%
      to:
        - "apri"
        - "chiudi"
      for:
        minutes: 5
  condition: []
  action:
    - action: persistent_notification.create
      data:
        notification_id: "finestra_%%id%%"
        title: >-
          {% set consiglio = states('sensor.consiglio_finestra_%%id%%') %}
          {% if consiglio == 'apri' %}
            🪟 Apri la finestra – %%friendly_name%%
          {% elif consiglio == 'chiudi' %}
            🔒 Chiudi la finestra – %%friendly_name%%
          {% else %}
            ℹ️ Consiglio finestra – %%friendly_name%%
          {% endif %}
        message: >-
          {% set consiglio = states('sensor.consiglio_finestra_%%id%%') %}
          {% set motivo = state_attr('sensor.consiglio_finestra_%%id%%', 'motivo') | default('N/A') %}
          {% set delta = state_attr('sensor.consiglio_finestra_%%id%%', 'delta_omega') | float(0) | round(2) %}
          {% set trend = state_attr('sensor.consiglio_finestra_%%id%%', 'trend_umidita') | default('N/A') %}
          {% set finestra = state_attr('sensor.consiglio_finestra_%%id%%', 'finestra_aperta') %}
          {% set confidenza = state_attr('sensor.consiglio_finestra_%%id%%', 'confidenza') | default(0) %}
          {% set rh = states('sensor.umidita_%%id%%_pilota') | float(0) | round(1) %}
          **Stanza:** %%friendly_name%%
          **Consiglio:** {{ consiglio }}
          **Umidità interna:** {{ rh }}%
          **Trend umidità:** {{ trend }}
          **Delta omega:** {{ delta }} g/kg
          **Finestra dichiarata:** {{ 'aperta' if finestra else 'chiusa' }}
          **Confidenza:** {{ confidenza }}%
          **Motivo:** {{ motivo }}

- alias: "%%friendly_name%%: Rimuovi Notifica Finestra"
  id: rimuovi_notifica_finestra_%%id%%
  trigger:
    - platform: state
      entity_id: sensor.consiglio_finestra_%%id%%
      to:
        - "nessuna_azione"
        - "incerto"
        - "mantieni_aperta"
        - "mantieni_chiusa"
  condition: []
  action:
    - action: persistent_notification.dismiss
      data:
        notification_id: "finestra_%%id%%"
