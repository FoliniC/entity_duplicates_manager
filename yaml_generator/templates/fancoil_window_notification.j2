# Generated by: %%generator_name%%
# Template: %%template_name%%
# Generated at: %%generation_time%%

# FASE 7 & FASE 9 - Notifiche consiglio finestra e valutazione efficacia
# Si attiva quando il consiglio finestra cambia e rimane stabile per 5 minuti.
# Invia una persistent_notification con contesto completo.
# La notifica viene rimossa quando il consiglio torna a nessuna_azione/incerto.

- alias: "%%friendly_name%%: Notifica Consiglio Finestra"
  id: notifica_consiglio_finestra_%%id%%
  trigger:
    - platform: state
      entity_id: sensor.consiglio_finestra_%%id%%
      to:
        - "apri"
        - "chiudi"
      for:
        minutes: 5
  condition: []
  action:
    - action: persistent_notification.create
      data:
        notification_id: "finestra_%%id%%"
        title: >-
          {% set consiglio = states('sensor.consiglio_finestra_%%id%%') %}
          {% if consiglio == 'apri' %}
            🪟 Apri la finestra – %%friendly_name%%
          {% elif consiglio == 'chiudi' %}
            🔒 Chiudi la finestra – %%friendly_name%%
          {% else %}
            ℹ️ Consiglio finestra – %%friendly_name%%
          {% endif %}
        message: >-
          {% set consiglio = states('sensor.consiglio_finestra_%%id%%') %}
          {% set motivo = state_attr('sensor.consiglio_finestra_%%id%%', 'motivo') | default('N/A') %}
          {% set delta = state_attr('sensor.consiglio_finestra_%%id%%', 'delta_omega') | float(0) | round(2) %}
          {% set trend = state_attr('sensor.consiglio_finestra_%%id%%', 'trend_umidita') | default('N/A') %}
          {% set finestra = state_attr('sensor.consiglio_finestra_%%id%%', 'finestra_aperta') %}
          {% set confidenza = state_attr('sensor.consiglio_finestra_%%id%%', 'confidenza') | default(0) %}
          {% set rh = states('sensor.umidita_%%id%%_pilota') | float(0) | round(1) %}
          {% set esito_prec = states('sensor.esito_ultimo_consiglio_finestra_%%id%%') %}
          {% set motivo_esito = state_attr('sensor.esito_ultimo_consiglio_finestra_%%id%%', 'motivo') %}
          
          **Stanza:** %%friendly_name%%
          **Consiglio:** {{ consiglio | upper }}
          **Umidità interna:** {{ rh }}%
          **Trend umidità:** {{ trend }}
          **Delta omega:** {{ delta }} g/kg
          **Finestra dichiarata:** {{ 'aperta' if finestra else 'chiusa' }}
          **Confidenza:** {{ confidenza }}%
          **Motivo:** {{ motivo }}
          
          {% if esito_prec in ['efficace', 'inefficace'] %}
          ---
          **Esito Ultima Azione:** {{ esito_prec | upper }}
          *Dettaglio:* {{ motivo_esito }}
          {% endif %}

- alias: "%%friendly_name%%: Rimuovi Notifica Finestra"
  id: rimuovi_notifica_finestra_%%id%%
  trigger:
    - platform: state
      entity_id: sensor.consiglio_finestra_%%id%%
      to:
        - "nessuna_azione"
        - "incerto"
        - "mantieni_aperta"
        - "mantieni_chiusa"
  condition: []
  action:
    - action: persistent_notification.dismiss
      data:
        notification_id: "finestra_%%id%%"

- alias: "%%friendly_name%%: Notifica Esito Consiglio Finestra"
  id: notifica_esito_consiglio_finestra_%%id%%
  trigger:
    - platform: state
      entity_id: sensor.esito_ultimo_consiglio_finestra_%%id%%
      to:
        - "efficace"
        - "inefficace"
  action:
    - action: persistent_notification.create
      data:
        notification_id: "esito_finestra_%%id%%"
        title: >-
          {% set esito = trigger.to_state.state %}
          {% if esito == 'efficace' %}
            ✅ Azione Efficace – %%friendly_name%%
          {% else %}
            ⚠️ Azione Inefficace – %%friendly_name%%
          {% endif %}
        message: >-
          {% set esito = trigger.to_state.state %}
          {% set attrs = trigger.to_state.attributes %}
          {% set tipo = attrs.get('tipo_azione') | default('N/A') %}
          {% set rh_ini = attrs.get('umidita_inizio') | float(0) | round(1) %}
          {% set rh_15 = attrs.get('umidita_15m') %}
          {% set rh_30 = attrs.get('umidita_30m') %}
          {% set rh_60 = attrs.get('umidita_60m') %}
          
          La valutazione per l'azione di **{{ tipo | upper }}** in **%%friendly_name%%** si è conclusa con esito: **{{ esito | upper }}**.
          
          - Umidità iniziale: {{ rh_ini }}%
          {% if rh_15 is not none and rh_15 != '' %}- Dopo 15m: {{ rh_15 | float(0) | round(1) }}% (Δ: {{ attrs.get('delta_umidita_15m') | float(0) | round(2) }}%){% endif %}
          {% if rh_30 is not none and rh_30 != '' %}- Dopo 30m: {{ rh_30 | float(0) | round(1) }}% (Δ: {{ attrs.get('delta_umidita_30m') | float(0) | round(2) }}%){% endif %}
          {% if rh_60 is not none and rh_60 != '' %}- Dopo 60m: {{ rh_60 | float(0) | round(1) }}% (Δ: {{ attrs.get('delta_umidita_60m') | float(0) | round(2) }}%){% endif %}
          
          **Motivo:** {{ attrs.get('motivo') }}
    - event: fancoil_log_event
      event_data:
        level: INFO
        message: >-
          {% set esito = trigger.to_state.state %}
          {% set attrs = trigger.to_state.attributes %}
          {% set tipo = attrs.get('tipo_azione') | default('N/A') %}
          {% set rh_ini = attrs.get('umidita_inizio') | float(0) | round(1) %}
          {% set rh_30 = attrs.get('umidita_30m') | default('N/A') %}
          [%%friendly_name%%] EVALUATION: Esito consiglio finestra: {{ esito | upper }} | Azione: {{ tipo }} | RH inizio: {{ rh_ini }}% -> 30m: {{ rh_30 }}% | Motivo: {{ attrs.get('motivo') }}
