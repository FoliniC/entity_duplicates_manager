# FASE 4 - Sensori pilota per stanza
# Centralizza la scelta del sensore (temperatura + umidita) usato dai calcoli climatici.
# Affidabilita definita a priori dalla lista ordinata in fancoil_vars.yaml:
# il primo sensore disponibile (non unknown/unavailable) vince.

# ---------------------------------------------------------------------------
# Umidita pilota: prima sorgente disponibile nell'ordine [primary] + fallback.
# Se nessuna e disponibile -> stato 'unavailable'.
# ---------------------------------------------------------------------------
- name: "Umidità %%friendly_name%% Pilota"
  unique_id: umidita_%%id%%_pilota
  unit_of_measurement: "%"
  state_class: measurement
  device_class: humidity
  state: >
    {% set primary_ent = '%%HUMIDITY_PRIMARY%%' %}
    {% set fallback_ents = %%HUMIDITY_FALLBACK_LIST_JINJA%% %}
    {% set ns = namespace(value=none, source='') %}
    {% for ent in [primary_ent] + fallback_ents %}
      {% if ns.value is none and has_value(ent) %}
        {% set ns.value = states(ent) | float(0) %}
        {% set ns.source = ent %}
      {% endif %}
    {% endfor %}
    {% if ns.value is none %}unavailable{% else %}{{ ns.value | round(1) }}{% endif %}
  availability: >
    {{ %%HUMIDITY_AVAIL_JINJA%% }}
  attributes:
    primary_sensor: "%%HUMIDITY_PRIMARY%%"
    fallback_sensors: "%%HUMIDITY_FALLBACK_LIST_JINJA%%"
    active_sensor: >
      {% set primary_ent = '%%HUMIDITY_PRIMARY%%' %}
      {% set fallback_ents = %%HUMIDITY_FALLBACK_LIST_JINJA%% %}
      {% set ns = namespace(source='') %}
      {% for ent in [primary_ent] + fallback_ents %}
        {% if ns.source == '' and has_value(ent) %}
          {% set ns.source = ent %}
        {% endif %}
      {% endfor %}
      {{ ns.source if ns.source != '' else 'none' }}

# ---------------------------------------------------------------------------
# Temperatura pilota: delega al sensore 'reale_calcolata' esistente, che gia
# gestisce la selezione interattiva (input_select.fancoil_<id>_temp_source)
# e il fallback automatico al sensore interno. Delegare evita di duplicare
# quella logica stanza per stanza. Unique_id uniforme *_pilota per i consumer.
# ---------------------------------------------------------------------------
- name: "Temperatura %%friendly_name%% Pilota"
  unique_id: temperatura_%%id%%_pilota
  unit_of_measurement: "°C"
  state_class: measurement
  device_class: temperature
  state: >
    {% set val = states('sensor.temperatura_%%id%%_reale_calcolata') %}
    {{ val if val not in ['unavailable', 'unknown', 'none', None, ''] else 'unavailable' }}
  availability: >
    {{ has_value('sensor.temperatura_%%id%%_reale_calcolata') }}
  attributes:
    source_sensor: sensor.temperatura_%%id%%_reale_calcolata